---
import Simple from "../../views/Simple.astro";
import ProcessSteps from "../../components/ProcessSteps.astro";
import Lifecycle from "../../components/Lifecycle.astro";
import Standards from "../../components/Standards.astro";
import Modular from "../../components/Modular.astro";
import Commitments from "../../components/Commitments.astro";
import Faq from "../../components/Faq.astro";
import CtaBand from "../../components/CtaBand.astro";
---
<Simple lang="en" wide title="How we work" description="How The Meowpany works: a 9-stage lifecycle with verifiable gates, IFPUG estimating, ISO/IEC/IEEE 29148 requirements, PERT planning, traceable testing and information security." lead="Every project follows the same 9-stage lifecycle we run in our management platform. No stage ends until what it requires is met: nothing depends on anyone’s memory.">
  <nav class="jump" aria-label="On this page"><a href="#the-journey-simply">The journey, simply</a><a href="#the-9-stages-in-detail">The 9 stages in detail</a><a href="#standards-and-practices">Standards and practices</a><a href="#modular-engineering">Modular engineering</a><a href="#what-you-get-on-every-project">What you get on every project</a><a href="#how-we-keep-you-informed">How we keep you informed</a><a href="#frequently-asked-questions">Frequently asked questions</a></nav>
  <h2 id="the-journey-simply">The journey, simply</h2>
  <ProcessSteps lang="en" />

  <h2 id="the-9-stages-in-detail">The 9 stages in detail</h2>
  <Lifecycle lang="en" />

  <h2 id="standards-and-practices">Standards and practices</h2>
  <Standards lang="en" />

  <h2 id="modular-engineering">Modular engineering</h2>
  <Modular lang="en" />

  <h2 id="what-you-get-on-every-project">What you get on every project</h2>
  <Commitments lang="en" />

  <h2 id="how-we-keep-you-informed">How we keep you informed</h2>
  <div class="table-wrap cards">
    <table class="compare">
      <thead><tr><th scope="col">What</th><th scope="col">When</th><th scope="col">Why</th></tr></thead>
      <tbody>
        <tr><th scope="row">Progress report</th><td data-label="When">Weekly</td><td data-label="Why">Hours used, finished and upcoming work, pending decisions and expected date.</td></tr>
        <tr><th scope="row">Demo</th><td data-label="When">Every 2 weeks</td><td data-label="Why">You see and try what was built on a staging environment, and approve or ask for changes.</td></tr>
        <tr><th scope="row">Meeting minutes</th><td data-label="When">After every meeting</td><td data-label="Why">What was decided is written down for your approval.</td></tr>
        <tr><th scope="row">Change request</th><td data-label="When">Whenever you need</td><td data-label="Why">Anything outside the scope is quoted before it is done, never after.</td></tr>
      </tbody>
    </table>
  </div>

  <h2 id="frequently-asked-questions">Frequently asked questions</h2>
  <Faq lang="en" />

  <CtaBand slot="after" lang="en" title="Start with the first version" text="A 30-minute call and, within 72 hours, your idea working." />
</Simple>

---
import Simple from "../../views/Simple.astro";
import QuoteForm from "../../components/QuoteForm.astro";
import { prices } from "../../pricing";
---
<Simple lang="en" title="Hire developers" description="Uruguayan developers in your time zone, from USD 35 an hour." lead={`Uruguayan developers who overlap with your working day, from USD ${prices.hours.rate} an hour.`}>
  <h2>Why Uruguay</h2>
  <ul>
    <li>Uruguay is 1 to 2 hours ahead of US Eastern time, so most of the day overlaps.</li>
    <li>Its tech sector sold USD 3.7 billion in 2024, and most of it was exported.</li>
    <li>A stable country with reliable infrastructure and strong English skills in tech.</li>
  </ul>
  <h2>How it works</h2>
  <ol>
    <li>A 30-minute call about your stack, team and goals.</li>
    <li>We propose a developer or a small team, hourly or full time.</li>
    <li>A two-week trial. If it is not a fit, you stop with no penalty.</li>
    <li>Weekly reports of hours and work, invoiced in USD.</li>
  </ol>
  <QuoteForm lang="en" preset="hours" />
</Simple>

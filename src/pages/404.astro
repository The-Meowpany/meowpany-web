---
import Base from "../layouts/Base.astro";
import Logo from "../components/Logo.astro";
---
<Base lang="es" title="Página no encontrada" description="Esta página no existe." noindex>
  <section class="section center">
    <div class="wrap">
      <Logo size={96} withText={false} />
      <h1>Este gato se perdió</h1>
      <p class="lead">La página que busca no existe o cambió de lugar. <span lang="en">This page doesn't exist.</span></p>
      <div class="actions" style="justify-content:center">
        <a class="btn btn-accent" href="/">Volver al inicio</a>
        <a class="btn btn-ghost" href="/en/" lang="en">English home</a>
      </div>
    </div>
  </section>
</Base>

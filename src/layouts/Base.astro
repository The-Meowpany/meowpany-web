---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import WhatsAppFloat from "../components/WhatsAppFloat.astro";
import PartnerBar from "../components/PartnerBar.astro";
import { alternate, type Lang, t } from "../i18n";
import { site } from "../site";
import { services } from "../content";
import { withBase } from "../lib/url";

interface Props {
  lang: Lang;
  title: string;
  description: string;
  noindex?: boolean;
}
const { lang, title, description, noindex = false } = Astro.props;
const fullTitle = title === site.name ? `${site.name} · ${t(lang).tagline}` : `${title} · ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const otherLang: Lang = lang === "es" ? "en" : "es";
const otherUrl = new URL(alternate(Astro.url.pathname, lang), Astro.site);
const esUrl = lang === "es" ? canonical : otherUrl;
const enUrl = lang === "en" ? canonical : otherUrl;

// Structured data so search engines understand who we are and what we sell.
const schema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: site.name,
  description: t(lang).tagline,
  url: Astro.site?.toString(),
  email: site.email,
  areaServed: ["UY", "US"],
  address: { "@type": "PostalAddress", addressLocality: "Montevideo", addressCountry: "UY" },
  sameAs: [site.linkedin],
  // Additional type definitions for SEO
  makesOffer: services[lang].map((service) => ({
    "@type": "Service",
    name: service.title,
    description: service.summary,
    areaServed: "UY",
    provider: { "@id": "#organization" }
  })) || undefined,
};

// GitHub Pages cannot send response headers, so the content policy travels in the page itself.
// connect-src lists the only services the browser talks to: the form inbox and PageSpeed Insights.
const contentPolicy = [
  "default-src 'self'",
  "script-src 'self' 'unsafe-inline'",
  "style-src 'self' 'unsafe-inline'",
  "img-src 'self' data:",
  "font-src 'self'",
  "connect-src 'self' https://api.web3forms.com https://www.googleapis.com",
  "object-src 'none'",
  "base-uri 'self'",
  "form-action 'self'",
  "upgrade-insecure-requests",
].join("; ");
---
<!doctype html>
<html lang={lang === "es" ? "es-UY" : "en"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="Content-Security-Policy" content={contentPolicy} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es-UY" href={esUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={esUrl} />
    <link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml" />
    <link rel="preconnect" href="https://www.googleapis.com" crossorigin />
    <link rel="preconnect" href="https://web3forms.com" crossorigin />
    <link rel="dns-prefetch" href="https://www.google.com" />
    <link rel="dns-prefetch" href="https://www.linkedin.com" />
    <link rel="apple-touch-icon" href={withBase("/brand/mark.svg")} sizes="180x180" />
    <meta name="msapplication-TileColor" content="#ffffff" />
    <script is:inline>
      // Theme and dismissed notices are settled before the first paint, so nothing flashes.
      (() => {
        const root = document.documentElement;
        let stored = null;
        try { stored = localStorage.getItem("theme"); if (localStorage.getItem("partner-bar") === "closed") root.dataset.partnerBar = "closed"; } catch {}
        const dark = stored ? stored === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
        root.dataset.theme = dark ? "dark" : "light";
      })();
    </script>
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(withBase("/og.png"), Astro.site)} />
    <meta property="og:locale" content={lang === "es" ? "es_UY" : "en_US"} />
    <meta property="og:locale:alternate" content={otherLang === "es" ? "es_UY" : "en_US"} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#content">{t(lang).skip}</a>
    <Header lang={lang} />
    <PartnerBar lang={lang} />
    <main id="content">
      <slot />
    </main>
    <Footer lang={lang} />
    <WhatsAppFloat lang={lang} />
    <script>
      // Reveal sections once as they scroll into view. Without JavaScript everything stays visible.
      const items = document.querySelectorAll<HTMLElement>(".reveal");
      // Siblings appear one after another rather than all at once.
      items.forEach((item) => {
        const siblings = [...(item.parentElement?.children ?? [])].filter((el) => el.classList.contains("reveal"));
        const index = Math.min(siblings.indexOf(item), 6);
        if (index > 0) item.style.setProperty("--reveal-delay", `${index * 80}ms`);
      });
      if ("IntersectionObserver" in window) {
        const observer = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("visible");
              observer.unobserve(entry.target);
            }
          }
        }, { rootMargin: "0px 0px -10% 0px" });
        items.forEach((item) => observer.observe(item));
        // Section titles draw their pink rule as they arrive.
        const heads = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("in");
              heads.unobserve(entry.target);
            }
          }
        }, { rootMargin: "0px 0px -15% 0px" });
        document.querySelectorAll(".section-head").forEach((head) => heads.observe(head));
        // In-page contents mark the section being read.
        const jump = document.querySelector(".jump");
        if (jump) {
          const links = [...jump.querySelectorAll<HTMLAnchorElement>("a[href^='#']")];
          const spy = new IntersectionObserver((entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              links.forEach((link) => {
                const on = link.hash === `#${entry.target.id}`;
                link.classList.toggle("on", on);
                if (on) jump.scrollTo({ left: link.offsetLeft - 24, behavior: "smooth" });
              });
            }
          }, { rootMargin: "-25% 0px -65% 0px" });
          links.forEach((link) => { const target = document.getElementById(link.hash.slice(1)); if (target) spy.observe(target); });
        }
      } else {
        items.forEach((item) => item.classList.add("visible"));
        document.querySelectorAll(".section-head").forEach((head) => head.classList.add("in"));
      }
    </script>
    <noscript><style>.reveal { opacity: 1; transform: none; } .section-head h2::after { transform: none; opacity: 1; }</style></noscript>
  </body>
</html>

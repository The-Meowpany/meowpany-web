---
// How a project gets its price. There is no price list: the page explains what drives the price,
// when the client learns it, and what never changes about how it is set.
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import SupportPlans from "../components/SupportPlans.astro";
import CtaBand from "../components/CtaBand.astro";
import { path, type Lang, t } from "../i18n";
import { launch, offers } from "../pricing";

interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = t(lang);
const copy = {
  es: {
    title: "Presupuestos", description: "Cómo se fija el precio de un sitio, una app o un sistema a medida en The Meowpany: cotización según los requisitos de cada proyecto y precio cerrado por escrito.",
    h1: "Cada proyecto tiene su precio, y lo conoce antes de pagar",
    lead: "No trabajamos con una lista de precios: un sitio de tres páginas y una app conectada con su facturación no cuestan lo mismo. Medimos lo que su proyecto necesita, se lo mostramos funcionando y recién ahí le enviamos un precio cerrado por escrito.",
    stepsTitle: "Cómo llega a su precio",
    steps: [
      { icon: "messages-square", title: "Conversamos", text: "Treinta minutos, sin costo, para entender qué quiere resolver y con qué trabaja hoy." },
      { icon: "zap", title: "Ve una primera versión", text: "En 72 horas le mostramos su idea funcionando. Sin anticipo, sin tarjeta y sin contrato." },
      { icon: "file-check", title: "Recibe el precio cerrado", text: "Una propuesta con el alcance función por función, el plazo y el precio, que no cambia salvo que usted pida algo fuera de ese alcance." },
      { icon: "circle-check", title: "Usted decide", text: "Si le convence, seguimos. Si no, termina ahí: no paga nada y no le insistimos." },
    ],
    driversTitle: "Qué define el precio", driversLead: "Cinco cosas, las mismas para todos los proyectos. En la propuesta ve cuánto pesa cada una en el suyo.",
    drivers: [
      { icon: "ruler", title: "Alcance", text: "Las páginas, pantallas y funciones que necesita. En los sistemas lo medimos en puntos de función (norma IFPUG), un método estándar y verificable." },
      { icon: "plug", title: "Integraciones", text: "Medios de pago, facturación electrónica, envíos o los sistemas que su empresa ya usa." },
      { icon: "palette", title: "Contenido y diseño", text: "Si ya tiene textos, fotos e identidad visual, o si hay que crearlos con usted." },
      { icon: "calendar-clock", title: "Plazo", text: "La fecha en que lo necesita y cuánto equipo hace falta para llegar." },
      { icon: "life-buoy", title: "Después de la entrega", text: "Si quiere un plan de soporte y cuántas horas de mejoras por mes." },
    ],
    termsTitle: "Condiciones claras",
    promiseTitle: "Lo que no cambia de un proyecto a otro",
    promise: [
      "El mismo método de estimación para todos, con el detalle a la vista.",
      "Precio cerrado por escrito antes de que pague nada.",
      "Cada cambio de alcance se cotiza y se aprueba antes de hacerlo.",
      "Una demostración cada 2 semanas y garantía de 60 días.",
    ],
    payTitle: "Cómo se paga", pay: [
      "Si decide avanzar: 50 % al aprobar la propuesta y 50 % en la entrega.",
      "Los proyectos más grandes se pagan por hitos acordados en el contrato.",
      "Transferencia bancaria, Mercado Pago o tarjeta, también en 3 cuotas.",
      `Si se lleva solo el código, sin soporte, hasta ${offers.codeOnlyInstallments} cuotas mensuales sin interés.`,
    ],
    launchTitle: "Beneficios",
    launchText: `Su sitio o app viene con ${offers.starterSupportMonths} meses de soporte incluidos, el soporte anual tiene ${offers.annualFreeMonths} meses sin cargo y, si nos recomienda, ganan los dos. Los primeros ${launch.clients} clientes tienen además un descuento sobre su cotización.`,
    offers: "Ver todos los beneficios",
    referenceTitle: "¿Quiere una referencia ahora?",
    referenceText: "Describa su sistema en el estimador: calcula un rango orientativo para su proyecto con el mismo método que usamos internamente.",
    estimate: "Estimar mi proyecto",
    supportTitle: "Planes de soporte", supportLead: `Opcionales, mes a mes y sin permanencia mínima. Pagando el año por adelantado, ${offers.annualFreeMonths} meses son sin cargo.`,
    ctaTitle: "Pida su cotización", ctaText: "Cuéntenos qué necesita y le enviamos una propuesta con alcance y precio cerrado.",
  },
  en: {
    title: "Pricing", description: "How The Meowpany prices a website, app or custom system: a quote built from each project's requirements and a fixed price in writing.",
    h1: "Every project has its own price, and you know it before you pay",
    lead: "We don't work from a price list: a three-page website and an app wired into your invoicing don't cost the same. We size what your project needs, show it to you working, and only then send a fixed price in writing.",
    stepsTitle: "How you get to your price",
    steps: [
      { icon: "messages-square", title: "We talk", text: "Thirty minutes, free, to understand what you want to solve and how you work today." },
      { icon: "zap", title: "You see a first version", text: "Within 72 hours we show you your idea working. No deposit, no card, no contract." },
      { icon: "file-check", title: "You get a fixed price", text: "A proposal with the scope function by function, the timeline and the price, which won't change unless you ask for something outside that scope." },
      { icon: "circle-check", title: "You decide", text: "If it convinces you, we carry on. If not, that's the end of it: you pay nothing and we won't chase you." },
    ],
    driversTitle: "What sets the price", driversLead: "Five things, the same for every project. The proposal shows how much each one weighs in yours.",
    drivers: [
      { icon: "ruler", title: "Scope", text: "The pages, screens and features you need. For systems we measure it in function points (IFPUG), a standard, verifiable method." },
      { icon: "plug", title: "Integrations", text: "Payment methods, e-invoicing, shipping or the systems your company already runs." },
      { icon: "palette", title: "Content and design", text: "Whether you already have copy, photos and a visual identity, or we create them with you." },
      { icon: "calendar-clock", title: "Timeline", text: "When you need it and how much team it takes to get there." },
      { icon: "life-buoy", title: "After launch", text: "Whether you want a support plan and how many improvement hours a month." },
    ],
    termsTitle: "Clear terms",
    promiseTitle: "What stays the same on every project",
    promise: [
      "The same estimation method for everyone, with the detail in view.",
      "A fixed price in writing before you pay anything.",
      "Every scope change is quoted and approved before we make it.",
      "A demo every 2 weeks and a 60-day warranty.",
    ],
    payTitle: "Payment", pay: [
      "If you go ahead: 50 % when you approve the proposal and 50 % on delivery.",
      "Larger projects are paid by milestones set in the contract.",
      `Code only, without support: up to ${offers.codeOnlyInstallments} interest-free monthly instalments.`,
      "Invoices in US dollars.",
    ],
    launchTitle: "Offers",
    launchText: `Your website or app comes with ${offers.starterSupportMonths} months of support included, annual support has ${offers.annualFreeMonths} months free and, if you refer someone, you both win. Our first ${launch.clients} clients also get a discount on their quote.`,
    offers: "See every offer",
    referenceTitle: "Want a reference right now?",
    referenceText: "Describe your system in the estimator: it computes an indicative range for your project with the same method we use internally.",
    estimate: "Estimate my project",
    supportTitle: "Support plans", supportLead: `Optional, month to month, no minimum term. Pay a year in advance and ${offers.annualFreeMonths} months are free.`,
    ctaTitle: "Ask for your quote", ctaText: "Tell us what you need and we'll send a proposal with the scope and a fixed price.",
  },
}[lang];
---
<Base lang={lang} title={copy.title} description={copy.description}>
  <header class="page-head">
    <div class="wrap">
      <h1>{copy.h1}</h1>
      <p class="lead">{copy.lead}</p>
    </div>
  </header>
  <section class="section">
    <div class="wrap">
      <div class="section-head reveal"><h2>{copy.stepsTitle}</h2></div>
      <ol class="steps balance">
        {copy.steps.map((step) => (
          <li class="card step reveal">
            <span class="icon"><Icon name={step.icon} /></span>
            <h3>{step.title}</h3>
            <p class="muted">{step.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>
  <section class="section soft">
    <div class="wrap">
      <div class="section-head reveal"><h2>{copy.driversTitle}</h2><p class="lead">{copy.driversLead}</p></div>
      <div class="drivers balance">
        {copy.drivers.map((driver) => (
          <article class="card driver reveal">
            <span class="icon"><Icon name={driver.icon} /></span>
            <h3>{driver.title}</h3>
            <p class="muted">{driver.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <div class="section-head reveal"><h2>{copy.termsTitle}</h2></div>
      <div class="terms">
        <div class="reveal">
          <h3>{copy.promiseTitle}</h3>
          <ul class="check-list">{copy.promise.map((item) => <li><span>{item}</span></li>)}</ul>
        </div>
        <div class="reveal">
          <h3>{copy.payTitle}</h3>
          <ul class="check-list">{copy.pay.map((item) => <li><span>{item}</span></li>)}</ul>
          <p class="muted small vat">{ui.price.vat}.</p>
        </div>
      </div>
      <div class="links balance">
        <a class="card link reveal" href={path("offers", lang)}>
          <span class="icon"><Icon name="gift" /></span>
          <span><strong>{copy.launchTitle}</strong><span class="muted">{copy.launchText}</span></span>
          <Icon name="arrow-right" />
        </a>
        <a class="card link reveal" href={path("estimate", lang)}>
          <span class="icon"><Icon name="calculator" /></span>
          <span><strong>{copy.referenceTitle}</strong><span class="muted">{copy.referenceText}</span></span>
          <Icon name="arrow-right" />
        </a>
      </div>
    </div>
  </section>
  <section class="section soft">
    <div class="wrap">
      <div class="section-head reveal"><h2>{copy.supportTitle}</h2><p class="lead">{copy.supportLead}</p></div>
      <SupportPlans lang={lang} />
    </div>
  </section>
  <CtaBand lang={lang} title={copy.ctaTitle} text={copy.ctaText} />
</Base>
<style>
  .terms { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 clamp(2rem, 5vw, 4rem); max-width: 980px; margin: 0 auto; }
  .terms > div + div { border-left: 1px solid var(--line); padding-left: clamp(2rem, 5vw, 4rem); }
  .terms h3 { font-size: 1.15rem; margin-bottom: 1rem; }
  .vat { margin: 1rem 0 0; }
  .links { margin: clamp(2.5rem, 5vw, 3.5rem) auto 0; max-width: 980px; }
  /* Icon, text and arrow all start on the same line, so two cards with different copy still line up. */
  .link { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: 1rem; align-items: start; text-decoration: none; color: inherit; }
  .link .icon { width: 40px; height: 40px; margin: 0; }
  .link strong { display: block; margin-bottom: 0.3rem; font-size: 1.05rem; }
  .link .muted { font-size: 0.93rem; line-height: 1.5; }
  .link > :global(svg) { width: 18px; height: 18px; margin-top: 0.35rem; color: var(--primary); transition: transform 200ms var(--ease); }
  .link:hover > :global(svg) { transform: translateX(3px); }
  /* Side by side the cards are too narrow for the copy: the headline wraps in one and not the other,
     and the paragraphs start at different heights. Below 900px they read better as a single column. */
  @media (max-width: 940px) { .links { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 760px) { .terms { grid-template-columns: minmax(0, 1fr); gap: 2rem; } .terms > div + div { border-left: 0; padding-left: 0; } }
  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; }
  .step, .driver { position: relative; display: flex; flex-direction: column; gap: 0.5rem; }
  .step h3, .driver h3 { margin: 0.4rem 0 0; font-size: 1.1rem; }
  .step p, .driver p { margin: 0; }
  .icon { display: inline-grid; place-items: center; width: 42px; height: 42px; border-radius: 12px; background: var(--soft); color: var(--primary); }
  .icon :global(svg) { width: 21px; height: 21px; }
  .soft .icon { background: var(--bg); }
  .drivers { display: grid; gap: 1rem; }
</style>

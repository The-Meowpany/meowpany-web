---
import Base from "../layouts/Base.astro";
import SupportPlans from "../components/SupportPlans.astro";
import CtaBand from "../components/CtaBand.astro";
import { money, type Lang, t } from "../i18n";
import { prices } from "../pricing";

interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = t(lang);
const copy = {
  es: {
    title: "Precios", description: "Precios de lista de The Meowpany: sitios desde USD 1.000, tiendas desde USD 2.200 y soporte desde USD 50 por mes.",
    h1: "Precios claros, antes de empezar",
    lead: "Estos son nuestros precios de lista. Después de una reunión le enviamos un precio cerrado que no cambia, salvo que usted solicite algo fuera del alcance.",
    head: ["Servicio", "Precio", "Incluye"],
    rows: [
      ["Sitio institucional", `${ui.price.from} ${money(prices.website.from, lang)}`, `Hasta ${prices.website.includedPages} páginas; cada página extra, ${money(prices.website.extraPage, lang)}`],
      ["Tienda en línea", `${ui.price.from} ${money(prices.store.from, lang)}`, `Hasta ${prices.store.largeCatalogThreshold} productos y facturación electrónica; catálogo mayor, + ${money(prices.store.largeCatalog, lang)}`],
      ["Sistema a medida", `${ui.price.from} ${money(prices.custom.from, lang)}`, `Proyecto típico: ${money(prices.custom.typical, lang)}. Se estima por puntos de función`],
      ["Desarrollo para el exterior", `${money(prices.hours.rate, lang)} ${ui.price.perHour}`, "Por hora o con dedicación completa"],
    ],
    payment: "Formas de pago: nada antes de ver la primera versión funcionando. Si decide avanzar, 50 % al continuar y 50 % en la entrega; por hitos en proyectos de más de USD 6.000. Transferencia, Mercado Pago o tarjeta (hasta 3 cuotas).",
    launch: "Precio de lanzamiento: los primeros 5 clientes tienen sitio a USD 800 y tienda a USD 1.900.",
    supportTitle: "Planes de soporte",
    ctaTitle: "Solicite su precio cerrado", ctaText: "Use el cotizador y lo contactaremos en menos de un día hábil.",
  },
  en: {
    title: "Pricing", description: "The Meowpany list prices: websites from USD 1,000, stores from USD 2,200, developers at USD 35 an hour.",
    h1: "Clear prices, before we start",
    lead: "These are our list prices. After one call we send a fixed price that won't change unless you ask for something outside the scope.",
    head: ["Service", "Price", "Includes"],
    rows: [
      ["Business website", `${ui.price.from} ${money(prices.website.from, lang)}`, `Up to ${prices.website.includedPages} pages; each extra page ${money(prices.website.extraPage, lang)}`],
      ["Online store", `${ui.price.from} ${money(prices.store.from, lang)}`, `Up to ${prices.store.largeCatalogThreshold} products; larger catalogs + ${money(prices.store.largeCatalog, lang)}`],
      ["Custom system", `${ui.price.from} ${money(prices.custom.from, lang)}`, `Typical project: ${money(prices.custom.typical, lang)}. Estimated with function points`],
      ["Developers for hire", `${money(prices.hours.rate, lang)} ${ui.price.perHour}`, "Hourly or full time"],
    ],
    payment: "Payment: nothing before you see the first version working. If you go ahead, 50 % to continue and 50 % on delivery; milestones for projects over USD 6,000. Invoices in USD.",
    launch: "",
    supportTitle: "Support plans",
    ctaTitle: "Get your fixed price", ctaText: "Use the quote form and we'll reach out within one business day.",
  },
}[lang];
---
<Base lang={lang} title={copy.title} description={copy.description}>
  <section class="section">
    <div class="wrap">
      <h1>{copy.h1}</h1>
      <p class="lead">{copy.lead}</p>
      <div class="table-wrap card" style="padding:0">
        <table class="compare">
          <thead><tr>{copy.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
          <tbody>{copy.rows.map(([name, price, detail]) => <tr><th scope="row">{name}</th><td><strong>{price}</strong></td><td class="muted">{detail}</td></tr>)}</tbody>
        </table>
      </div>
      <p class="muted" style="margin-top:1rem">{ui.price.vat}. {copy.payment}</p>
      {copy.launch && <p class="notice">{copy.launch}</p>}
      <h2 style="margin-top:3rem">{copy.supportTitle}</h2>
      <SupportPlans lang={lang} />
    </div>
  </section>
  <CtaBand lang={lang} title={copy.ctaTitle} text={copy.ctaText} />
</Base>

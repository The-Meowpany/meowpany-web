---
import Base from "../layouts/Base.astro";
import ServiceCards from "../components/ServiceCards.astro";
import CtaBand from "../components/CtaBand.astro";
import { type Lang, t } from "../i18n";

interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = t(lang);
const copy = {
  es: {
    title: "Servicios", description: "Sitios institucionales, tiendas en línea, sistemas a medida, soporte mensual y desarrolladores para el exterior.",
    h1: "Servicios", lead: "Cinco servicios con alcance claro, plazo escrito y precio de lista publicado.",
    ctaTitle: "¿No sabe cuál necesita?", ctaText: "Cuéntenos el problema y le recomendaremos la opción más simple que lo resuelva.",
  },
  en: {
    title: "Services", description: "Business websites, online stores, custom systems, monthly support and developers for hire.",
    h1: "Services", lead: "Five services with a clear scope, a written timeline and a published list price.",
    ctaTitle: "Not sure which one you need?", ctaText: "Tell us the problem and we'll recommend the simplest option that solves it.",
  },
}[lang];
---
<Base lang={lang} title={copy.title} description={copy.description}>
  <section class="section">
    <div class="wrap">
      <h1>{copy.h1}</h1>
      <p class="lead">{copy.lead}</p>
      <ServiceCards lang={lang} detailed />
      <p class="muted" style="margin-top:1rem">{ui.price.vat}</p>
    </div>
  </section>
  <CtaBand lang={lang} title={copy.ctaTitle} text={copy.ctaText} />
</Base>

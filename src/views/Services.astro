---
import Base from "../layouts/Base.astro";
import ServiceCards from "../components/ServiceCards.astro";
import Commitments from "../components/Commitments.astro";
import Engagement from "../components/Engagement.astro";
import CtaBand from "../components/CtaBand.astro";
import { path, type Lang, t } from "../i18n";

interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = t(lang);
const copy = {
  es: {
    title: "Servicios", description: "Sitios web institucionales, apps, software a medida, soporte mensual y desarrolladores para el exterior: qué incluye cada uno y sus plazos. Cada proyecto se cotiza según lo que necesita.",
    h1: "Webs, apps y software, con alcance y plazo por escrito",
    lead: "Cinco servicios con lo que incluyen, lo que se cobra aparte y el plazo. El precio se cotiza para cada proyecto.",
    commitTitle: "Reglas que aplican a todos los servicios",
    modelsTitle: "Contrate como le resulte más cómodo", modelsLead: "Un proyecto con precio cerrado, un plan mensual para seguir creciendo o desarrolladores que se suman a su equipo.",
    ctaTitle: "¿No sabe cuál necesita?", ctaText: "Cuéntenos el problema y le recomendamos la opción más simple que lo resuelva.",
    pricing: "Cómo cotizamos",
  },
  en: {
    title: "Services", description: "Business websites, apps, custom software, monthly support and developers for hire: what each includes and its timeline. Every project is quoted for what it needs.",
    h1: "Websites, apps and software, with scope and price in writing",
    lead: "Five services with what they include, what costs extra and the timeline. Each project is quoted on its own.",
    commitTitle: "Rules that apply to every service",
    modelsTitle: "Work with us the way that suits you", modelsLead: "A fixed-price project, a monthly plan to keep growing, or developers who join your team.",
    ctaTitle: "Not sure which one you need?", ctaText: "Tell us the problem and we'll recommend the simplest option that solves it.",
    pricing: "How we price",
  },
}[lang];
---
<Base lang={lang} title={copy.title} description={copy.description}>
  <header class="page-head">
    <div class="wrap">
      <h1>{copy.h1}</h1>
      <p class="lead">{copy.lead}</p>
      <div class="actions"><a class="btn btn-ghost btn-sm" href={path("pricing", lang)}>{copy.pricing}</a></div>
    </div>
  </header>
  <section class="section">
    <div class="wrap">
      <ServiceCards lang={lang} detailed />
      <p class="note">{ui.price.vat}.</p>
    </div>
  </section>
  <section class="section soft">
    <div class="wrap">
      <div class="section-head"><h2>{copy.modelsTitle}</h2><p class="lead">{copy.modelsLead}</p></div>
      <Engagement lang={lang} />
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <div class="section-head"><h2>{copy.commitTitle}</h2></div>
      <Commitments lang={lang} />
    </div>
  </section>
  <CtaBand lang={lang} title={copy.ctaTitle} text={copy.ctaText} />
</Base>

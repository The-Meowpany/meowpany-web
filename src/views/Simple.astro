---
// A content page: a header band (eyebrow, title, lead) and free-form content. Used by about, work,
// resources, contact, process, privacy and terms.
import Base from "../layouts/Base.astro";
import type { Lang } from "../i18n";

interface Props { lang: Lang; title: string; description: string; lead?: string; eyebrow?: string; noindex?: boolean; wide?: boolean }
const { lang, title, description, lead, eyebrow, noindex, wide = false } = Astro.props;
---
<Base lang={lang} title={title} description={description} noindex={noindex}>
  <header class="page-head">
    <div class="wrap">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{title}</h1>
      {lead && <p class="lead">{lead}</p>}
    </div>
  </header>
  <section class="section page-body">
    <div class:list={["wrap", "prose", { wide }]}>
      <slot />
    </div>
  </section>
  <slot name="after" />
</Base>
<style>
  .page-body { padding-top: clamp(2.5rem, 5vw, 4rem); }
  .prose { max-width: 780px; }
  .prose.wide { max-width: var(--max); }
  .prose :global(h2) { margin-top: 2.75rem; font-size: clamp(1.4rem, 2.4vw, 1.85rem); }
  .prose :global(h2:first-child) { margin-top: 0; }
  .prose :global(h3) { margin-top: 1.75rem; }
  .prose :global(.card h3), .prose :global(li h3), .prose :global(.head h3) { margin-top: 0; }
  .prose :global(p), .prose :global(li) { color: var(--ink-2); }
  .prose :global(ul:not([class])), .prose :global(ol:not([class])) { padding-left: 1.2rem; }
  .prose :global(li) { margin-bottom: 0.45rem; }
</style>

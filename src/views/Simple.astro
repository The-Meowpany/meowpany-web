---
// A plain content page: a heading, a lead and free-form content. Used by work, about,
// resources, privacy and terms, which are mostly text.
import Base from "../layouts/Base.astro";
import type { Lang } from "../i18n";

interface Props { lang: Lang; title: string; description: string; lead?: string; noindex?: boolean }
const { lang, title, description, lead, noindex } = Astro.props;
---
<Base lang={lang} title={title} description={description} noindex={noindex}>
  <section class="section">
    <div class="wrap prose">
      <h1>{title}</h1>
      {lead && <p class="lead">{lead}</p>}
      <slot />
    </div>
  </section>
  <slot name="after" />
</Base>
<style>
  .prose { max-width: 820px; }
  .prose :global(h2) { margin-top: 2.5rem; font-size: 1.6rem; }
  .prose :global(li) { margin-bottom: 0.4rem; }
</style>

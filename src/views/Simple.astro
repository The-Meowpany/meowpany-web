---
// A content page: a header band (title and lead) and free-form content. Used by about, work,
// resources, contact, process, privacy and terms.
import Base from "../layouts/Base.astro";
import type { Lang } from "../i18n";

interface Props { lang: Lang; title: string; description: string; lead?: string; noindex?: boolean; wide?: boolean }
const { lang, title, description, lead, noindex, wide = false } = Astro.props;
---
<Base lang={lang} title={title} description={description} noindex={noindex}>
  <header class="page-head">
    <div class="wrap">
      <h1>{title}</h1>
      {lead && <p class="lead">{lead}</p>}
    </div>
  </header>
  <section class="section page-body">
    <div class:list={["wrap", "prose", { wide }]}>
      <slot />
    </div>
  </section>
  <slot name="after" />
</Base>
<style>
  /* Reading pages are a centred column; wide pages stack full-width blocks under centred titles. */
  .prose { max-width: 780px; }
  .prose.wide { max-width: var(--max); }
  .prose > :global(h2) { margin-top: 2.75rem; font-size: clamp(1.4rem, 2.4vw, 1.85rem); }
  .prose > :global(h2)::after { content: ""; display: block; width: 36px; height: 4px; border-radius: 4px; background: var(--brand); margin-top: 0.5em; }
  .prose > :global(h2:first-child) { margin-top: 0; }
  .wide > :global(h2) { text-align: center; max-width: 760px; margin: clamp(3.5rem, 7vw, 5rem) auto 2rem; font-size: clamp(1.6rem, 3vw, 2.2rem); }
  .wide > :global(h2)::after { width: 44px; margin-inline: auto; }
  .wide > :global(h2:first-child) { margin-top: 0; }
  .wide > :global(p) { text-align: center; max-width: 46rem; margin-inline: auto; }
  .wide > :global(.quote) { margin-inline: auto; }
  .prose :global(h3) { margin-top: 1.75rem; }
  .prose :global(.card h3), .prose :global(li h3), .prose :global(.head h3) { margin-top: 0; }
  .prose :global(p), .prose :global(li) { color: var(--ink-2); }
  .prose :global(ul:not([class])), .prose :global(ol:not([class])) { padding-left: 1.2rem; }
  .prose :global(li) { margin-bottom: 0.45rem; }
</style>

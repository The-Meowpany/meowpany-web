---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import ServiceCards from "../components/ServiceCards.astro";
import Faq from "../components/Faq.astro";
import CtaBand from "../components/CtaBand.astro";
import FirstVersion from "../components/FirstVersion.astro";
import Facts from "../components/Facts.astro";
import Comparison from "../components/Comparison.astro";
import NewsCover from "../components/NewsCover.astro";
import { formatDate, newsPath, posts } from "../news";
import { faq, firstVersion } from "../content";
import { path, type Lang, t } from "../i18n";
import { launch } from "../pricing";
import { withBase } from "../lib/url";

interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = t(lang);

const copy = {
  es: {
    description: "Sitios web, tiendas en línea y software a medida para pymes. Vea una primera versión funcionando en 72 horas, antes de pagar. Precio cerrado, demostraciones cada 2 semanas y garantía de 60 días.",
    title: ["Desarrollamos su", "sitio, app o sistema", "a medida."],
    lead: "En 72 horas tiene una primera versión funcional de su idea. La prueba con su equipo y recién ahí decide si seguimos. Sin anticipo y sin tarjeta.",
    secondary: "Diagnóstico de 2 minutos",
    trust: ["Precio cerrado antes de avanzar", "Demostración cada 2 semanas", "Garantía de 60 días", "El código es suyo"],
    panel: { title: "Su proyecto", status: "Sin costo hasta acá", rows: [["Llamada de 30 minutos", "Hoy", "done"], ["Alcance por escrito", "Hoy", "done"], ["Primera versión funcional", "En 72 horas", "now"], ["Usted decide si seguimos", "Sin compromiso", "next"]], preview: "Vista previa privada" },
    servicesTitle: "Todo lo que una pyme necesita para vender y trabajar mejor en línea", servicesLead: "Plazos escritos y lo que incluye cada servicio, sin letra chica. Cada proyecto se cotiza según lo que necesita.",
    factsTitle: "La mayoría de las pymes todavía no aprovecha internet", factsLead: "Datos públicos de Uruguay. Cada cifra enlaza a su fuente.",
    compareTitle: "Qué recibe con nosotros y qué con las alternativas", compareLead: "La misma pregunta que se haría usted antes de contratar, respondida con hechos.",
    methodology: "Ver la metodología completa",
    newsTitle: "Lo último", newsAll: "Ver todas las novedades",
    faqTitle: "Preguntas frecuentes",
    ctaTitle: "Cuéntenos su idea", ctaText: `Treinta minutos alcanzan para saber qué incluiría su primera versión. Los primeros ${launch.clients} clientes tienen un descuento sobre su cotización.`,
  },
  en: {
    description: "Websites, online stores and custom software. See a first working version within 72 hours, before you pay. Fixed price, a demo every 2 weeks and a 60-day warranty.",
    title: ["We build your", "website, app or custom system", "tailored to you."],
    lead: "Within 72 hours you get a first working version of your idea. Try it with your team, and only then decide whether we go ahead. No deposit, no card.",
    secondary: "2-minute diagnosis",
    trust: ["Fixed price before you commit", "A demo every 2 weeks", "60-day warranty", "You own the code"],
    panel: { title: "Your project", status: "Free so far", rows: [["30-minute call", "Today", "done"], ["Scope in writing", "Today", "done"], ["First working version", "Within 72 hours", "now"], ["You decide whether we go on", "No strings", "next"]], preview: "Private preview" },
    servicesTitle: "What a business needs to sell and work better online", servicesLead: "Written timelines and exactly what each service includes. Every project is quoted for what it needs.",
    factsTitle: "Most small businesses are still offline", factsLead: "Public figures from Uruguay. Each one links to its source.",
    compareTitle: "What you get with us, and with the alternatives", compareLead: "The question you would ask before hiring, answered with facts.",
    methodology: "See the full methodology",
    newsTitle: "Latest", newsAll: "See all news",
    faqTitle: "Frequently asked questions",
    ctaTitle: "Tell us your idea", ctaText: "Thirty minutes is enough to know what your first version would include.",
  },
}[lang];

// The offer's questions first; the general payment question is replaced by the offer's own.
const latest = posts(lang).slice(0, 3);
const questions = [...firstVersion.faq[lang], ...faq[lang].filter((item) => !/pag|pay/i.test(item.q.slice(0, 12)))];
---
<Base lang={lang} title="The Meowpany" description={copy.description}>
  <section class="hero">
    <div class="glow" aria-hidden="true"></div>
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <h1>{copy.title[0]} <span class="highlight">{copy.title[1]}</span> {copy.title[2]}</h1>
        <p class="lead">{copy.lead}</p>
        <div class="actions">
          <a class="btn btn-primary" href={`${path("book", lang)}?for=prototype`}>{ui.seeItWorking}<Icon name="arrow-right" /></a>
          <a class="btn btn-ghost" href={path("diagnosis", lang)}><Icon name="stethoscope" />{copy.secondary}</a>
        </div>
        <ul class="trust">
          {copy.trust.map((item) => <li><Icon name="check" />{item}</li>)}
        </ul>
      </div>

      <div class="panel" aria-hidden="true">
        <div class="panel-head">
          <img class="cat light" src={withBase("/brand/mark.svg")} width="38" height="30" alt="" />
          <img class="cat dark" src={withBase("/brand/mark-dark.svg")} width="38" height="30" alt="" />
          <strong>{copy.panel.title}</strong>
          <span class="badge brand">{copy.panel.status}</span>
        </div>
        <ol class="timeline">
          {copy.panel.rows.map(([label, when, state]) => (
            <li class={state}><span class="dot"></span><span class="label">{label}</span><span class="when">{when}</span></li>
          ))}
        </ol>
        <div class="window">
          <div class="chrome"><span></span><span></span><span></span><em>{copy.panel.preview}</em></div>
          <div class="screen">
            <div class="side"><i></i><i></i><i></i><i></i></div>
            <div class="main">
              <div class="kpis"><b></b><b></b><b></b></div>
              <div class="chart"><span style="height:38%"></span><span style="height:56%"></span><span style="height:47%"></span><span style="height:72%"></span><span style="height:64%"></span><span style="height:88%"></span><span style="height:80%"></span></div>
              <div class="rows"><i></i><i></i><i></i></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section soft">
    <div class="wrap">
      <div class="section-head">
        <h2 class="reveal">{copy.servicesTitle}</h2>
        <p class="lead reveal">{copy.servicesLead}</p>
      </div>
      <ServiceCards lang={lang} />
      <p class="note">{ui.price.vat}.</p>
    </div>
  </section>

  <FirstVersion lang={lang} id={lang === "es" ? "primera-version" : "first-version"} />

  <section class="section soft">
    <div class="wrap">
      <div class="section-head">
        <h2 class="reveal">{copy.compareTitle}</h2>
        <p class="lead reveal">{copy.compareLead}</p>
      </div>
      <Comparison lang={lang} />
      <p class="more-link"><a class="btn btn-ghost" href={path("process", lang)}>{copy.methodology}<Icon name="arrow-right" /></a></p>
    </div>
  </section>

  {lang === "es" && (
    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <h2 class="reveal">{copy.factsTitle}</h2>
          <p class="lead reveal">{copy.factsLead}</p>
        </div>
        <Facts lang={lang} />
      </div>
    </section>
  )}

  <section class:list={["section", { soft: lang === "es" }]}>
    <div class="wrap faq-grid">
      <h2 class="reveal title-rule start">{copy.faqTitle}</h2>
      <Faq lang={lang} items={questions} />
    </div>
  </section>

  <section class:list={["section", { soft: lang === "en" }]}>
    <div class="wrap">
      <div class="section-head">
        <h2 class="reveal">{copy.newsTitle}</h2>
      </div>
      <ol class="latest balance">
        {latest.map((post) => (
          <li class="reveal"><a class="story" href={newsPath(lang, post.slug)}>
            <NewsCover topic={post.topic} label={post.tag} />
            <p class="news-meta"><span>{post.tag}</span>{formatDate(post.date, lang)}</p>
            <h3>{post.title}</h3></a></li>
        ))}
      </ol>
      <p class="more-link"><a class="btn btn-ghost" href={newsPath(lang)}>{copy.newsAll}<Icon name="arrow-right" /></a></p>
    </div>
  </section>

  <CtaBand lang={lang} title={copy.ctaTitle} text={copy.ctaText} />
</Base>

<style>
  .hero { position: relative; overflow: hidden; padding: clamp(2.25rem, 5vw, 4rem) 0 clamp(3rem, 6vw, 4.5rem); }
  .glow {
    position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background:
      radial-gradient(60% 55% at 85% 10%, var(--glow), transparent 70%),
      linear-gradient(to right, var(--line) 1px, transparent 1px) 0 0 / 56px 56px,
      linear-gradient(to bottom, var(--line) 1px, transparent 1px) 0 0 / 56px 56px;
    mask-image: radial-gradient(80% 70% at 60% 0%, #000 30%, transparent 80%);
    opacity: 0.9;
  }
  .hero-grid { display: grid; grid-template-columns: 1.25fr 0.85fr; gap: clamp(2rem, 4vw, 4rem); align-items: center; }
  .hero h1 { font-size: clamp(2.35rem, 4.4vw, 3.7rem); }
  .highlight {
    color: var(--primary);
    background: linear-gradient(var(--brand-line), var(--brand-line)) 0 92% / 0% 0.18em no-repeat;
    animation: underline 900ms 650ms var(--ease) forwards;
  }
  @keyframes underline { to { background-size: 100% 0.18em; } }
  /* The opening appears in reading order, then the project panel plays its timeline. */
  .hero-copy > * { animation: rise 700ms var(--ease) both; }
  .hero-copy > :nth-child(2) { animation-delay: 80ms; }
  .hero-copy > :nth-child(3) { animation-delay: 160ms; }
  .hero-copy > :nth-child(4) { animation-delay: 240ms; }
  .hero-copy > :nth-child(5) { animation-delay: 320ms; }
  .panel { animation: rise 800ms 250ms var(--ease) both; }
  .timeline li { animation: rise 500ms var(--ease) both; }
  .timeline li:nth-child(1) { animation-delay: 550ms; }
  .timeline li:nth-child(2) { animation-delay: 700ms; }
  .timeline li:nth-child(3) { animation-delay: 850ms; }
  .timeline li:nth-child(4) { animation-delay: 1000ms; }
  .done .dot { animation: check 400ms var(--ease) both; }
  .timeline li:nth-child(1) .dot { animation-delay: 750ms; }
  .timeline li:nth-child(2) .dot { animation-delay: 900ms; }
  @keyframes check { from { transform: scale(0.4); background: var(--bg); } to { transform: scale(1); } }
  .now .dot::after {
    content: ""; position: absolute; inset: -6px; border-radius: 50%; border: 2px solid var(--brand);
    animation: ping 2.4s 1.3s var(--ease) infinite; opacity: 0;
  }
  @keyframes ping { 0% { transform: scale(0.6); opacity: 0.7; } 80%, 100% { transform: scale(1.5); opacity: 0; } }
  .chart span { transform-origin: bottom; animation: grow 700ms var(--ease) both; }
  .chart span:nth-child(1) { animation-delay: 1100ms; }
  .chart span:nth-child(2) { animation-delay: 1160ms; }
  .chart span:nth-child(3) { animation-delay: 1220ms; }
  .chart span:nth-child(4) { animation-delay: 1280ms; }
  .chart span:nth-child(5) { animation-delay: 1340ms; }
  .chart span:nth-child(6) { animation-delay: 1400ms; }
  .chart span:nth-child(7) { animation-delay: 1460ms; }
  @keyframes grow { from { transform: scaleY(0); } }
  @media (prefers-reduced-motion: reduce) {
    .now .dot::after { display: none; }
    .done .dot { animation: none !important; }
    @keyframes grow { from { opacity: 0; } }
  }
  .trust { list-style: none; padding: 0; margin: 2rem 0 0; display: flex; flex-wrap: wrap; gap: 0.6rem 1.4rem; color: var(--muted); font-size: 0.92rem; }
  .trust li { display: inline-flex; align-items: center; gap: 0.4rem; }
  .trust :global(svg) { width: 16px; height: 16px; color: var(--primary); }

  .panel { border: 1px solid var(--line); border-radius: 22px; background: var(--bg); box-shadow: 0 30px 60px -30px rgb(43 40 45 / 30%), var(--shadow-sm); padding: 1.25rem; }
  .panel-head { display: flex; align-items: center; gap: 0.7rem; padding: 0.25rem 0.25rem 1rem; border-bottom: 1px solid var(--line); }
  .panel-head strong { font-size: 0.98rem; }
  .cat.dark { display: none; }
  :global([data-theme="dark"]) .cat.light { display: none; }
  :global([data-theme="dark"]) .cat.dark { display: block; }
  .panel-head .badge { margin-left: auto; }
  .timeline { list-style: none; padding: 0.5rem 0.25rem; margin: 0; }
  .timeline li { position: relative; display: grid; grid-template-columns: 18px 1fr auto; gap: 0.75rem; align-items: center; padding: 0.7rem 0; font-size: 0.93rem; }
  .timeline li:not(:last-child)::after { content: ""; position: absolute; left: 8px; top: 2.1rem; bottom: -0.55rem; width: 2px; background: var(--line); }
  .dot { width: 18px; height: 18px; border-radius: 50%; border: 2px solid var(--line-strong); background: var(--bg); position: relative; z-index: 1; }
  .done .dot { background: var(--primary); border-color: var(--primary); box-shadow: inset 0 0 0 3px var(--bg); }
  .now .dot { border-color: var(--primary); box-shadow: 0 0 0 4px var(--brand-soft); }
  .now .label { font-weight: 650; }
  .when { color: var(--muted); font-size: 0.82rem; }
  .next .label { color: var(--muted); }
  .window { margin-top: 0.75rem; border: 1px solid var(--line); border-radius: 14px; overflow: hidden; background: var(--soft); }
  .chrome { display: flex; align-items: center; gap: 0.35rem; padding: 0.55rem 0.75rem; border-bottom: 1px solid var(--line); background: var(--bg); }
  .chrome span { width: 9px; height: 9px; border-radius: 50%; background: var(--line-strong); }
  .chrome em { margin-left: auto; font-style: normal; font-size: 0.75rem; color: var(--muted); }
  .screen { display: grid; grid-template-columns: 70px 1fr; min-height: 168px; }
  .side { border-right: 1px solid var(--line); padding: 0.75rem 0.6rem; display: grid; gap: 0.45rem; align-content: start; background: var(--bg); }
  .side i { display: block; height: 7px; border-radius: 4px; background: var(--line); }
  .side i:first-child { background: var(--brand-line); }
  .main { padding: 0.75rem; display: grid; gap: 0.65rem; }
  .kpis { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.45rem; }
  .kpis b { height: 30px; border-radius: 8px; background: var(--bg); border: 1px solid var(--line); }
  .chart { display: flex; align-items: flex-end; gap: 6px; height: 64px; padding: 0.5rem; border-radius: 8px; background: var(--bg); border: 1px solid var(--line); }
  .chart span { flex: 1; border-radius: 3px 3px 0 0; background: linear-gradient(to top, var(--brand), color-mix(in srgb, var(--brand) 55%, transparent)); }
  .rows { display: grid; gap: 0.35rem; }
  .rows i { display: block; height: 7px; border-radius: 4px; background: var(--line); }
  .rows i:nth-child(2) { width: 82%; }
  .rows i:nth-child(3) { width: 64%; }

  .more-link { margin: 2rem 0 0; text-align: center; }
  .note { margin: 1.5rem 0 0; text-align: center; color: var(--muted); font-size: 0.9rem; }
  .latest { list-style: none; padding: 0; margin: 0; display: grid; gap: clamp(1.25rem, 3vw, 2rem); }
  .story { display: grid; gap: 0.6rem; height: 100%; text-decoration: none; color: inherit; }
  .story h3 { font-size: 1.15rem; line-height: 1.3; margin: 0; transition: color 200ms; }
  .story:hover h3 { color: var(--primary); }
  .story :global(.cover) { transition: transform 400ms var(--ease), box-shadow 400ms var(--ease); }
  .story:hover :global(.cover) { transform: translateY(-3px); box-shadow: var(--shadow); }
  .news-meta { display: flex; align-items: center; gap: 0.6rem; margin: 0.2rem 0 0; font-size: 0.84rem; color: var(--muted); }
  .news-meta span { color: var(--primary); font-weight: 700; }
  .faq-grid { display: grid; grid-template-columns: 0.7fr 1.3fr; gap: 2rem 4rem; align-items: start; }
  @media (max-width: 920px) {
    .hero-grid, .faq-grid { grid-template-columns: 1fr; }
    .panel { max-width: 520px; }
  }
  @media (max-width: 560px) {
    .panel { display: none; }
  }
</style>

---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import ServiceCards from "../components/ServiceCards.astro";
import ProcessSteps from "../components/ProcessSteps.astro";
import Faq from "../components/Faq.astro";
import CtaBand from "../components/CtaBand.astro";
import SupportPlans from "../components/SupportPlans.astro";
import FirstVersion from "../components/FirstVersion.astro";
import Commitments from "../components/Commitments.astro";
import Facts from "../components/Facts.astro";
import Tools from "../components/Tools.astro";
import Engagement from "../components/Engagement.astro";
import Comparison from "../components/Comparison.astro";
import Audiences from "../components/Audiences.astro";
import Modular from "../components/Modular.astro";
import { formatDate, newsPath, posts } from "../news";
import { faq, firstVersion } from "../content";
import { path, type Lang, t } from "../i18n";
import { launch } from "../pricing";
import { withBase } from "../lib/url";

interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = t(lang);

const copy = {
  es: {
    description: "Sitios web, tiendas en línea y software a medida para pymes. Vea una primera versión funcionando en 72 horas, antes de pagar. Precio cerrado, demostraciones cada 2 semanas y garantía de 60 días.",
    eyebrow: "Webs, tiendas y software a medida",
    title: ["Desarrollamos su", "sitio, tienda o sistema", "y lo ve funcionando antes de pagar"],
    lead: "En 72 horas tiene una primera versión funcional de su idea. La prueba con su equipo y recién ahí decide si seguimos. Sin anticipo y sin tarjeta.",
    secondary: "Ver servicios y precios",
    trust: ["Precio cerrado antes de avanzar", "Demostración cada 2 semanas", "Garantía de 60 días", "El código es suyo"],
    panel: { title: "Su proyecto", status: "Sin costo hasta acá", rows: [["Llamada de 30 minutos", "Hoy", "done"], ["Alcance por escrito", "Hoy", "done"], ["Primera versión funcional", "En 72 horas", "now"], ["Usted decide si seguimos", "Sin compromiso", "next"]], preview: "Vista previa privada" },
    servicesEyebrow: "Servicios", servicesTitle: "Todo lo que una pyme necesita para vender y trabajar mejor en línea", servicesLead: "Precios de lista publicados, plazos escritos y lo que incluye cada servicio, sin letra chica.",
    processEyebrow: "Proceso", processTitle: "De la primera llamada a la puesta en producción", processLead: "Seis pasos con duración conocida. Usted ve el avance real cada dos semanas.",
    commitEyebrow: "Garantías", commitTitle: "Lo que recibe en todos los proyectos", commitLead: "Sea un sitio de seis páginas o un sistema de gestión, trabajamos con las mismas reglas.",
    factsEyebrow: "Por qué ahora", factsTitle: "La mayoría de las pymes todavía no aprovecha internet", factsLead: "Datos públicos de Uruguay. Cada cifra enlaza a su fuente.",
    toolsEyebrow: "Herramientas gratuitas", toolsTitle: "Resultados concretos antes de hablar de precios", toolsLead: "Úselas sin registrarse. Solo nos llega lo que usted decida enviarnos.",
    supportEyebrow: "Después de la entrega", supportTitle: "Planes de soporte con plazos por escrito", supportLead: "Mes a mes y sin permanencia mínima.",
    modelsEyebrow: "Formas de trabajar", modelsTitle: "Contrate como le resulte más cómodo", modelsLead: "Un proyecto con precio cerrado, un plan mensual para seguir creciendo o desarrolladores que se suman a su equipo.",
    compareEyebrow: "Comparación", compareTitle: "Qué recibe con nosotros y qué con las alternativas", compareLead: "La misma pregunta que se haría usted antes de contratar, respondida con hechos.",
    audienceEyebrow: "Para quién", audienceTitle: "Trabajamos con empresas que ya venden y quieren hacerlo mejor", audienceLead: "Pymes de Uruguay de 5 a 99 personas y equipos del exterior.",
    methodology: "Ver la metodología completa",
    modularEyebrow: "Ingeniería", modularTitle: "Software a medida, construido sobre piezas probadas", modularLead: "Nuestro protocolo de ingeniería modular: lo común ya está resuelto y verificado, y lo único de su negocio se diseña para usted.",
    newsEyebrow: "Novedades", newsTitle: "Lo último", newsAll: "Ver todas las novedades",
    faqTitle: "Preguntas frecuentes",
    ctaTitle: "Cuéntenos su idea", ctaText: `Treinta minutos alcanzan para saber qué incluiría su primera versión. Los primeros ${launch.clients} clientes tienen precio de lanzamiento.`,
  },
  en: {
    description: "Websites, online stores and custom software. See a first working version within 72 hours, before you pay. Fixed price, a demo every 2 weeks and a 60-day warranty.",
    eyebrow: "Websites, stores and custom software",
    title: ["We build your", "website, store or system", "and you see it working before you pay"],
    lead: "Within 72 hours you get a first working version of your idea. Try it with your team, and only then decide whether we go ahead. No deposit, no card.",
    secondary: "See services and pricing",
    trust: ["Fixed price before you commit", "A demo every 2 weeks", "60-day warranty", "You own the code"],
    panel: { title: "Your project", status: "Free so far", rows: [["30-minute call", "Today", "done"], ["Scope in writing", "Today", "done"], ["First working version", "Within 72 hours", "now"], ["You decide whether we go on", "No strings", "next"]], preview: "Private preview" },
    servicesEyebrow: "Services", servicesTitle: "What a business needs to sell and work better online", servicesLead: "Published list prices, written timelines and exactly what each service includes.",
    processEyebrow: "Process", processTitle: "From the first call to going live", processLead: "Six steps with known durations. You see real progress every two weeks.",
    commitEyebrow: "Guarantees", commitTitle: "What you get on every project", commitLead: "A six-page website or a back-office system, the same rules apply.",
    factsEyebrow: "Why now", factsTitle: "Most small businesses are still offline", factsLead: "Public figures from Uruguay. Each one links to its source.",
    toolsEyebrow: "Free tools", toolsTitle: "Concrete results before any talk about price", toolsLead: "No sign-up. We only receive what you choose to send.",
    supportEyebrow: "After launch", supportTitle: "Support plans with written response times", supportLead: "Month to month, no minimum term.",
    modelsEyebrow: "Engagement models", modelsTitle: "Work with us the way that suits you", modelsLead: "A fixed-price project, a monthly plan to keep growing, or developers who join your team.",
    compareEyebrow: "Comparison", compareTitle: "What you get with us, and with the alternatives", compareLead: "The question you would ask before hiring, answered with facts.",
    audienceEyebrow: "Who we work with", audienceTitle: "Companies that already sell and want to do it better", audienceLead: "Growing businesses, startups and agencies.",
    methodology: "See the full methodology",
    modularEyebrow: "Engineering", modularTitle: "Custom software, built on proven parts", modularLead: "Our modular engineering protocol: what is common is already solved and verified, and what is unique to your business is designed for you.",
    newsEyebrow: "News", newsTitle: "Latest", newsAll: "See all news",
    faqTitle: "Frequently asked questions",
    ctaTitle: "Tell us your idea", ctaText: "Thirty minutes is enough to know what your first version would include.",
  },
}[lang];

// The offer's questions first; the general payment question is replaced by the offer's own.
const latest = posts(lang).slice(0, 3);
const questions = [...firstVersion.faq[lang], ...faq[lang].filter((item) => !/pag|pay/i.test(item.q.slice(0, 12)))];
---
<Base lang={lang} title="The Meowpany" description={copy.description}>
  <section class="hero">
    <div class="glow" aria-hidden="true"></div>
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">{copy.eyebrow}</p>
        <h1>{copy.title[0]} <span class="highlight">{copy.title[1]}</span> {copy.title[2]}</h1>
        <p class="lead">{copy.lead}</p>
        <div class="actions">
          <a class="btn btn-primary" href={`${path("book", lang)}?for=prototype`}>{ui.seeItWorking}<Icon name="arrow-right" /></a>
          <a class="btn btn-ghost" href={path("services", lang)}>{copy.secondary}</a>
        </div>
        <ul class="trust">
          {copy.trust.map((item) => <li><Icon name="check" />{item}</li>)}
        </ul>
      </div>

      <div class="panel" aria-hidden="true">
        <div class="panel-head">
          <img class="cat light" src={withBase("/brand/mark.svg")} width="38" height="30" alt="" />
          <img class="cat dark" src={withBase("/brand/mark-dark.svg")} width="38" height="30" alt="" />
          <strong>{copy.panel.title}</strong>
          <span class="badge brand">{copy.panel.status}</span>
        </div>
        <ol class="timeline">
          {copy.panel.rows.map(([label, when, state]) => (
            <li class={state}><span class="dot"></span><span class="label">{label}</span><span class="when">{when}</span></li>
          ))}
        </ol>
        <div class="window">
          <div class="chrome"><span></span><span></span><span></span><em>{copy.panel.preview}</em></div>
          <div class="screen">
            <div class="side"><i></i><i></i><i></i><i></i></div>
            <div class="main">
              <div class="kpis"><b></b><b></b><b></b></div>
              <div class="chart"><span style="height:38%"></span><span style="height:56%"></span><span style="height:47%"></span><span style="height:72%"></span><span style="height:64%"></span><span style="height:88%"></span><span style="height:80%"></span></div>
              <div class="rows"><i></i><i></i><i></i></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section soft">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow plain">{copy.servicesEyebrow}</p>
        <h2 class="reveal">{copy.servicesTitle}</h2>
        <p class="lead reveal">{copy.servicesLead}</p>
      </div>
      <ServiceCards lang={lang} />
      <p class="muted small" style="margin-top:1.25rem">{ui.price.vat}.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow plain">{copy.modelsEyebrow}</p>
        <h2 class="reveal">{copy.modelsTitle}</h2>
        <p class="lead reveal">{copy.modelsLead}</p>
      </div>
      <Engagement lang={lang} />
    </div>
  </section>

  <FirstVersion lang={lang} id={lang === "es" ? "primera-version" : "first-version"} />

  <section class="section soft">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow plain">{copy.processEyebrow}</p>
        <h2 class="reveal">{copy.processTitle}</h2>
        <p class="lead reveal">{copy.processLead}</p>
      </div>
      <ProcessSteps lang={lang} />
      <p class="more-link"><a class="btn btn-ghost" href={path("process", lang)}>{copy.methodology}<Icon name="arrow-right" /></a></p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow plain">{copy.modularEyebrow}</p>
        <h2 class="reveal">{copy.modularTitle}</h2>
        <p class="lead reveal">{copy.modularLead}</p>
      </div>
      <Modular lang={lang} />
    </div>
  </section>

  <section class="section soft">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow plain">{copy.compareEyebrow}</p>
        <h2 class="reveal">{copy.compareTitle}</h2>
        <p class="lead reveal">{copy.compareLead}</p>
      </div>
      <Comparison lang={lang} />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow plain">{copy.audienceEyebrow}</p>
        <h2 class="reveal">{copy.audienceTitle}</h2>
        <p class="lead reveal">{copy.audienceLead}</p>
      </div>
      <Audiences lang={lang} />
    </div>
  </section>

  <section class="section soft">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow plain">{copy.commitEyebrow}</p>
        <h2 class="reveal">{copy.commitTitle}</h2>
        <p class="lead reveal">{copy.commitLead}</p>
      </div>
      <Commitments lang={lang} />
    </div>
  </section>

  {lang === "es" && (
    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow plain">{copy.factsEyebrow}</p>
          <h2 class="reveal">{copy.factsTitle}</h2>
          <p class="lead reveal">{copy.factsLead}</p>
        </div>
        <Facts lang={lang} />
      </div>
    </section>
  )}

  <section class:list={["section", { soft: lang === "es" }]}>
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow plain">{copy.toolsEyebrow}</p>
        <h2 class="reveal">{copy.toolsTitle}</h2>
        <p class="lead reveal">{copy.toolsLead}</p>
      </div>
      <Tools lang={lang} />
    </div>
  </section>

  <section class:list={["section", { soft: lang === "en" }]}>
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow plain">{copy.supportEyebrow}</p>
        <h2 class="reveal">{copy.supportTitle}</h2>
        <p class="lead reveal">{copy.supportLead}</p>
      </div>
      <SupportPlans lang={lang} />
    </div>
  </section>

  <section class:list={["section", { soft: lang === "es" }]}>
    <div class="wrap faq-grid">
      <h2 class="reveal">{copy.faqTitle}</h2>
      <Faq lang={lang} items={questions} />
    </div>
  </section>

  <section class:list={["section", { soft: lang === "en" }]}>
    <div class="wrap">
      <div class="news-head">
        <div><p class="eyebrow plain">{copy.newsEyebrow}</p><h2 class="reveal">{copy.newsTitle}</h2></div>
        <a class="btn btn-ghost btn-sm" href={newsPath(lang)}>{copy.newsAll}</a>
      </div>
      <ol class="latest">
        {latest.map((post) => (
          <li class="reveal"><a class="card" href={newsPath(lang, post.slug)}>
            <p class="news-meta"><span class="badge brand">{post.tag}</span>{formatDate(post.date, lang)}</p>
            <h3>{post.title}</h3><p class="muted">{post.summary}</p></a></li>
        ))}
      </ol>
    </div>
  </section>

  <CtaBand lang={lang} title={copy.ctaTitle} text={copy.ctaText} />
</Base>

<style>
  .hero { position: relative; overflow: hidden; padding: clamp(3.5rem, 8vw, 6.5rem) 0 clamp(3.5rem, 7vw, 5.5rem); }
  .glow {
    position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background:
      radial-gradient(60% 55% at 85% 10%, rgb(202 103 142 / 16%), transparent 70%),
      linear-gradient(to right, var(--line) 1px, transparent 1px) 0 0 / 56px 56px,
      linear-gradient(to bottom, var(--line) 1px, transparent 1px) 0 0 / 56px 56px;
    mask-image: radial-gradient(80% 70% at 60% 0%, #000 30%, transparent 80%);
    opacity: 0.9;
  }
  .hero-grid { display: grid; grid-template-columns: 1.25fr 0.85fr; gap: clamp(2rem, 4vw, 4rem); align-items: center; }
  .hero h1 { font-size: clamp(2.35rem, 4.4vw, 3.7rem); }
  .highlight { color: var(--primary); }
  .trust { list-style: none; padding: 0; margin: 2rem 0 0; display: flex; flex-wrap: wrap; gap: 0.6rem 1.4rem; color: var(--muted); font-size: 0.92rem; }
  .trust li { display: inline-flex; align-items: center; gap: 0.4rem; }
  .trust :global(svg) { width: 16px; height: 16px; color: var(--primary); }

  .panel { border: 1px solid var(--line); border-radius: 22px; background: var(--bg); box-shadow: 0 30px 60px -30px rgb(43 40 45 / 30%), var(--shadow-sm); padding: 1.25rem; }
  .panel-head { display: flex; align-items: center; gap: 0.7rem; padding: 0.25rem 0.25rem 1rem; border-bottom: 1px solid var(--line); }
  .panel-head strong { font-size: 0.98rem; }
  .cat.dark { display: none; }
  @media (prefers-color-scheme: dark) { .cat.light { display: none; } .cat.dark { display: block; } }
  .panel-head .badge { margin-left: auto; }
  .timeline { list-style: none; padding: 0.5rem 0.25rem; margin: 0; }
  .timeline li { position: relative; display: grid; grid-template-columns: 18px 1fr auto; gap: 0.75rem; align-items: center; padding: 0.7rem 0; font-size: 0.93rem; }
  .timeline li:not(:last-child)::after { content: ""; position: absolute; left: 8px; top: 2.1rem; bottom: -0.55rem; width: 2px; background: var(--line); }
  .dot { width: 18px; height: 18px; border-radius: 50%; border: 2px solid var(--line-strong); background: var(--bg); position: relative; z-index: 1; }
  .done .dot { background: var(--primary); border-color: var(--primary); box-shadow: inset 0 0 0 3px var(--bg); }
  .now .dot { border-color: var(--primary); box-shadow: 0 0 0 4px var(--brand-soft); }
  .now .label { font-weight: 650; }
  .when { color: var(--muted); font-size: 0.82rem; }
  .next .label { color: var(--muted); }
  .window { margin-top: 0.75rem; border: 1px solid var(--line); border-radius: 14px; overflow: hidden; background: var(--soft); }
  .chrome { display: flex; align-items: center; gap: 0.35rem; padding: 0.55rem 0.75rem; border-bottom: 1px solid var(--line); background: var(--bg); }
  .chrome span { width: 9px; height: 9px; border-radius: 50%; background: var(--line-strong); }
  .chrome em { margin-left: auto; font-style: normal; font-size: 0.75rem; color: var(--muted); }
  .screen { display: grid; grid-template-columns: 70px 1fr; min-height: 168px; }
  .side { border-right: 1px solid var(--line); padding: 0.75rem 0.6rem; display: grid; gap: 0.45rem; align-content: start; background: var(--bg); }
  .side i { display: block; height: 7px; border-radius: 4px; background: var(--line); }
  .side i:first-child { background: var(--brand-line); }
  .main { padding: 0.75rem; display: grid; gap: 0.65rem; }
  .kpis { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.45rem; }
  .kpis b { height: 30px; border-radius: 8px; background: var(--bg); border: 1px solid var(--line); }
  .chart { display: flex; align-items: flex-end; gap: 6px; height: 64px; padding: 0.5rem; border-radius: 8px; background: var(--bg); border: 1px solid var(--line); }
  .chart span { flex: 1; border-radius: 3px 3px 0 0; background: linear-gradient(to top, var(--brand), color-mix(in srgb, var(--brand) 55%, transparent)); }
  .rows { display: grid; gap: 0.35rem; }
  .rows i { display: block; height: 7px; border-radius: 4px; background: var(--line); }
  .rows i:nth-child(2) { width: 82%; }
  .rows i:nth-child(3) { width: 64%; }

  .more-link { margin: 1.5rem 0 0; }
  .news-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 1rem; margin-bottom: 2rem; flex-wrap: wrap; }
  .news-head h2 { margin: 0; }
  .latest { list-style: none; padding: 0; margin: 0; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); }
  .latest a { display: block; height: 100%; text-decoration: none; color: inherit; }
  .latest p.muted { font-size: 0.95rem; }
  .news-meta { display: flex; align-items: center; gap: 0.6rem; font-size: 0.82rem; color: var(--muted); }
  .faq-grid { display: grid; grid-template-columns: 0.7fr 1.3fr; gap: 2rem 4rem; align-items: start; }
  @media (max-width: 920px) {
    .hero-grid, .faq-grid { grid-template-columns: 1fr; }
    .panel { max-width: 520px; }
  }
</style>

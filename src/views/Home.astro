---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import ServiceCards from "../components/ServiceCards.astro";
import ProcessSteps from "../components/ProcessSteps.astro";
import Faq from "../components/Faq.astro";
import CtaBand from "../components/CtaBand.astro";
import SupportPlans from "../components/SupportPlans.astro";
import FirstVersion from "../components/FirstVersion.astro";
import { faq, firstVersion } from "../content";
import { path, type Lang, t } from "../i18n";

interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = t(lang);

const copy = {
  es: {
    description: "Desarrollamos su App o Software y lo ve funcionando en 72 horas, antes de pagar. Sistemas a medida, apps, tiendas y sitios para pymes, con precio cerrado y soporte real.",
    eyebrow: "Desarrollo de apps y software · Montevideo",
    title: ["Desarrollamos su", "App o Software", "y lo ve funcionando antes de pagar"],
    lead: "En 72 horas tiene una primera versión funcional de su idea. La prueba, la muestra a su equipo y recién ahí decide si avanzamos. Sin anticipo y sin tarjeta.",
    secondary: "Cómo funciona",
    promises: [
      ["rocket", "Primera versión en 72 horas"],
      ["wallet", "Nada que pagar hasta verla funcionando"],
      ["badge-check", "Precio cerrado si decide avanzar"],
      ["code-xml", "El código y los accesos son suyos"],
    ],
    servicesTitle: "Lo que hacemos",
    servicesLead: "Precios de lista publicados. El precio final, cerrado, se fija antes de empezar.",
    processTitle: "Cómo trabajamos",
    processLead: "Seis pasos claros, de la primera reunión a la puesta en producción.",
    workTitle: "Casos",
    workText: "Estamos empezando: los primeros proyectos aparecerán aquí con el problema, la solución y el resultado medido, siempre con permiso del cliente. Los primeros 5 clientes tienen precio de lanzamiento.",
    supportTitle: "Planes de soporte",
    faqTitle: "Preguntas frecuentes",
    ctaTitle: "Cuéntenos qué necesita",
    ctaText: "En 2 minutos obtiene un precio estimado. Respondemos en menos de un día hábil.",
  },
  en: {
    description: "We build your app or software and you see it working within 72 hours, before you pay. Custom systems, apps, stores and websites from Uruguay, with fixed prices and real support.",
    eyebrow: "App and software development · Montevideo, Uruguay",
    title: ["We build your", "app or software", "and you see it working before you pay"],
    lead: "Within 72 hours you get a first working version of your idea. Try it, show it to your team, and only then decide whether we go ahead. No deposit, no card.",
    secondary: "How it works",
    promises: [
      ["rocket", "First version in 72 hours"],
      ["wallet", "Nothing to pay until you see it working"],
      ["badge-check", "A fixed price if you go ahead"],
      ["code-xml", "You own the code and every credential"],
    ],
    servicesTitle: "What we do",
    servicesLead: "Published list prices. You get a final, fixed price before any work starts.",
    processTitle: "How we work",
    processLead: "Six clear steps, from the first call to going live.",
    workTitle: "Work",
    workText: "We are just starting: our first projects will appear here with the problem, the solution and measured results, always with the client's permission.",
    supportTitle: "Support plans",
    faqTitle: "Frequently asked questions",
    ctaTitle: "Tell us what you need",
    ctaText: "Get an estimated price in 2 minutes. We reply within one business day.",
  },
}[lang];

// The offer's questions come first; the general payment question is replaced by the offer's own.
const questions = [...firstVersion.faq[lang], ...faq[lang].slice(0, 1), ...faq[lang].slice(2)];
---
<Base lang={lang} title="The Meowpany" description={copy.description}>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow">{copy.eyebrow}</p>
        <h1>{copy.title[0]} <span class="highlight">{copy.title[1]}</span> {copy.title[2]}</h1>
        <p class="lead">{copy.lead}</p>
        <div class="actions">
          <a class="btn btn-accent" href={`${path("book", lang)}?for=prototype`}>{ui.seeItWorking}<Icon name="arrow-right" /></a>
          <a class="btn btn-ghost" href={path("firstVersion", lang)}>{copy.secondary}<Icon name="arrow-down" /></a>
        </div>
      </div>
      <figure class="hero-art" aria-hidden="true">
        <svg viewBox="0 0 420 340" role="presentation">
          <rect x="40" y="40" width="340" height="230" rx="18" fill="var(--soft)" stroke="var(--line)" />
          <circle cx="68" cy="66" r="6" fill="#f87171" /><circle cx="88" cy="66" r="6" fill="var(--accent)" /><circle cx="108" cy="66" r="6" fill="#4ade80" />
          <g class="code" font-family="ui-monospace, monospace" font-size="15">
            <text x="68" y="112" fill="var(--primary)">const cat = new Meowpany();</text>
            <text x="68" y="140" fill="var(--muted)">{lang === "es" ? 'cat.build("su tienda");' : 'cat.build("your store");'}</text>
            <text x="68" y="168" fill="var(--muted)">{lang === "es" ? 'cat.ship({ demo: "72 h" });' : 'cat.ship({ demo: "72 h" });'}</text>
            <text x="68" y="196" fill="var(--muted)">cat.support(60);</text>
            <rect class="caret" x="68" y="210" width="10" height="18" fill="var(--accent)" />
          </g>
          <g transform="translate(270 190)">
            <path d="M9 33 L15 6 L31 21 M71 33 L65 6 L49 21" fill="var(--primary)" stroke="var(--primary)" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />
            <path d="M8 34 C8 62 24 74 40 74 C56 74 72 62 72 34 C72 26 60 21 40 21 C20 21 8 26 8 34 Z" fill="var(--primary)" />
            <g class="eyes"><circle cx="29" cy="42" r="5" fill="var(--accent)" /><circle cx="51" cy="42" r="5" fill="var(--accent)" /></g>
            <path d="M36 54 L40 58 L44 54" fill="none" stroke="var(--bg)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
          </g>
        </svg>
      </figure>
    </div>
    <div class="wrap">
      <ul class="promises">
        {copy.promises.map(([icon, text]) => <li><Icon name={icon} /><span>{text}</span></li>)}
      </ul>
    </div>
  </section>

  <FirstVersion lang={lang} id={lang === "es" ? "primera-version" : "first-version"} />

  <section class="section soft">
    <div class="wrap">
      <h2 class="reveal">{copy.servicesTitle}</h2>
      <p class="lead reveal">{copy.servicesLead}</p>
      <ServiceCards lang={lang} />
      <p class="muted" style="margin-top:1rem">{ui.price.vat}</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="reveal">{copy.processTitle}</h2>
      <p class="lead reveal">{copy.processLead}</p>
      <ProcessSteps lang={lang} />
    </div>
  </section>

  <section class="section soft">
    <div class="wrap">
      <h2 class="reveal">{copy.workTitle}</h2>
      <p class="notice reveal">{copy.workText}</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="reveal">{copy.supportTitle}</h2>
      <SupportPlans lang={lang} />
    </div>
  </section>

  <section class="section soft">
    <div class="wrap narrow">
      <h2 class="reveal">{copy.faqTitle}</h2>
      <Faq lang={lang} items={questions} />
    </div>
  </section>

  <CtaBand lang={lang} title={copy.ctaTitle} text={copy.ctaText} />
</Base>

<style>
  .hero { padding: clamp(2.5rem, 7vw, 5.5rem) 0 2.5rem; }
  .hero-grid { display: grid; gap: 2rem; grid-template-columns: 1.15fr 0.85fr; align-items: center; }
  .hero-art { margin: 0; }
  .highlight {
    background: linear-gradient(100deg, var(--primary), color-mix(in srgb, var(--primary) 55%, #8b5cf6));
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .hero-art svg { width: 100%; height: auto; filter: drop-shadow(0 12px 30px rgb(15 23 42 / 12%)); }
  .caret { animation: blink 1.1s steps(1) infinite; }
  .eyes { transform-origin: 40px 42px; animation: cat-blink 5s infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  @keyframes cat-blink { 0%, 92%, 100% { transform: scaleY(1); } 95% { transform: scaleY(0.1); } }
  .promises { list-style: none; padding: 0; margin: 2rem 0 0; display: grid; gap: 0.75rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr)); }
  .promises li { display: flex; align-items: center; gap: 0.6rem; font-weight: 550; }
  .promises :global(svg) { width: 22px; height: 22px; color: var(--primary); flex: none; }
  .narrow { max-width: 820px; }
  @media (max-width: 860px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-art { max-width: 420px; }
  }
</style>

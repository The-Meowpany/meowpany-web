---
// The Meowpany brand book: logo, colour, type, imagery, voice and downloads, in one page.
import Base from "../layouts/Base.astro";
import { type Lang } from "../i18n";
import { withBase } from "../lib/url";

interface Props { lang: Lang }
const { lang } = Astro.props;
const b = (file: string) => withBase(`/brand/${file}`);

const colors = [
  { name: "Rosa capucha / Hood pink", hex: "#CA678E", role: { es: "Color de la marca: el gato y los acentos.", en: "Brand colour: the cat and accents." }, ink: "#ffffff" },
  { name: "Rosa 600", hex: "#B04F76", role: { es: "Botones y enlaces sobre blanco (contraste AA).", en: "Buttons and links on white (AA contrast)." }, ink: "#ffffff" },
  { name: "Rosa 50", hex: "#FBF1F5", role: { es: "Fondos de destacados y etiquetas.", en: "Highlight and tag backgrounds." }, ink: "#8f3d5f" },
  { name: "Carbón / Charcoal", hex: "#433F45", role: { es: "Texto secundario, el gato en modo oscuro.", en: "Secondary text, the cat in dark mode." }, ink: "#ffffff" },
  { name: "Carbón 900", hex: "#2B282D", role: { es: "Texto principal y superficies oscuras.", en: "Main text and dark surfaces." }, ink: "#ffffff" },
  { name: "Gris cálido / Warm grey", hex: "#D9D9D9", role: { es: "La capucha del gato y los bordes.", en: "The cat's hood and borders." }, ink: "#2b282d" },
  { name: "Gris 50", hex: "#F7F6F7", role: { es: "Fondos de secciones alternas.", en: "Alternate section backgrounds." }, ink: "#2b282d" },
];

const copy = {
  es: {
    title: "Marca", description: "Manual de marca de The Meowpany: logo, colores, tipografía, imágenes, voz y tono, y archivos para descargar.",
    eyebrow: "Manual de marca", h1: "La marca The Meowpany",
    lead: "Cómo se ve, cómo se escribe y cómo se usa. Para nuestro equipo, la prensa y cualquiera que trabaje con nosotros.",
    toc: ["Logo", "Colores", "Tipografía", "Iconos e imágenes", "Voz y tono", "Descargas"],
    logo: {
      intro: "El logo tiene dos partes: el gato con capucha (el isotipo) y el nombre The Meowpany™ (el logotipo). Se usan juntos o el gato solo cuando el espacio es chico.",
      lightTab: "Modo claro", darkTab: "Modo oscuro",
      light: "Modo claro: gato rosa, logotipo carbón.", dark: "Modo oscuro: gato carbón, logotipo claro.",
      rules: ["Un solo gato por vista: el rosa en modo claro, el carbón en modo oscuro.", "Área de protección: alrededor del logo, un espacio libre igual a la mitad de la altura del gato.", "Tamaño mínimo: 16 px de alto el gato solo, 24 px el logo completo.", "Siempre con los archivos originales de abajo."],
      dontTitle: "No hacer", donts: ["Deformar, girar o recortar el logo.", "Cambiar sus colores o ponerle sombras, contornos o degradados.", "Usar los dos gatos en la misma pantalla.", "Ponerlo sobre fotos o fondos que le quiten contraste."],
    },
    colorsIntro: "Rosa para lo que importa, carbón para el texto y mucho blanco. El rosa 600 es el que se usa para texto y botones sobre blanco porque cumple el contraste AA.",
    type: {
      intro: "Dos familias, ambas libres: Fira Sans para títulos y cifras, Inter para todo lo demás.",
      display: "Fira Sans · títulos y cifras", text: "Inter · texto e interfaz",
      sample: "Su primera versión, funcionando en 72 horas", body: "Antes de invertir, prueba su idea convertida en software real. Si no lo convence, no sigue y no paga.",
      scale: ["Título principal: Fira Sans 800, de 38 a 66 px", "Títulos de sección: Fira Sans 700, de 28 a 42 px", "Texto: Inter 400, 16,5 px, interlineado 1,65", "Etiquetas: Inter 650, 12 px, mayúsculas con espaciado"],
    },
    imagery: ["Iconos: Lucide, trazo uniforme de 2 px, en rosa 600 sobre rosa 50.", "Imágenes: capturas reales de proyectos y fotos del equipo. Nada de fotos genéricas de bancos de imágenes.", "Ilustraciones: el gato; sin personajes ni escenas inventadas."],
    voice: {
      intro: "Hablamos como un buen profesional que explica las cosas claras.",
      rules: [["Trato de usted", "En todo el sitio, propuestas y correos con clientes de Uruguay."], ["Concreto", "Plazos, precios y hechos en lugar de adjetivos: «72 horas», no «rapidísimo»."], ["Sin jerga", "Hablamos de los problemas del cliente (vender en línea, ahorrar tiempo), no de tecnologías."], ["Honesto", "Si algo no existe todavía, no lo mostramos: ni casos inventados ni logos de clientes que no tenemos."], ["Un guiño felino, a veces", "El gato puede aparecer en una página de error o un mensaje de éxito. Nunca en precios, contratos ni términos legales."]],
    },
    downloads: "Archivos originales", files: [["Gato rosa (SVG)", "mark.svg"], ["Gato carbón (SVG)", "mark-dark.svg"], ["Logotipo carbón (PNG)", "wordmark-dark.png"], ["Logotipo claro (PNG)", "wordmark-light.png"]],
    copyHex: "Copiar", copied: "Copiado",
  },
  en: {
    title: "Brand", description: "The Meowpany brand book: logo, colours, typography, imagery, voice and tone, and downloadable files.",
    eyebrow: "Brand book", h1: "The Meowpany brand",
    lead: "How it looks, how it writes and how it is used. For our team, the press and anyone working with us.",
    toc: ["Logo", "Colours", "Typography", "Icons and imagery", "Voice and tone", "Downloads"],
    logo: {
      intro: "The logo has two parts: the hooded cat (the mark) and the name The Meowpany™ (the wordmark). Use them together, or the cat alone when space is tight.",
      lightTab: "Light mode", darkTab: "Dark mode",
      light: "Light mode: pink cat, charcoal wordmark.", dark: "Dark mode: charcoal cat, light wordmark.",
      rules: ["One cat per view: pink in light mode, charcoal in dark mode.", "Clear space: around the logo, free space equal to half the cat's height.", "Minimum size: 16 px tall for the cat alone, 24 px for the full logo.", "Always use the original files below."],
      dontTitle: "Don't", donts: ["Stretch, rotate or crop the logo.", "Change its colours or add shadows, outlines or gradients.", "Show both cats on the same screen.", "Place it on photos or backgrounds that kill its contrast."],
    },
    colorsIntro: "Pink for what matters, charcoal for text and plenty of white. Pink 600 is the one for text and buttons on white because it meets AA contrast.",
    type: {
      intro: "Two families, both free: Fira Sans for headings and figures, Inter for everything else.",
      display: "Fira Sans · headings and figures", text: "Inter · text and interface",
      sample: "Your first version, working in 72 hours", body: "Before you invest, try your idea as real software. If it doesn't convince you, you stop and pay nothing.",
      scale: ["Main title: Fira Sans 800, 38 to 66 px", "Section titles: Fira Sans 700, 28 to 42 px", "Body: Inter 400, 16.5 px, line height 1.65", "Labels: Inter 650, 12 px, spaced capitals"],
    },
    imagery: ["Icons: Lucide, even 2 px stroke, in pink 600 on pink 50.", "Imagery: real project screenshots and team photos. No generic stock photos.", "Illustration: the cat; no made-up characters or scenes."],
    voice: {
      intro: "We talk like a good professional who explains things plainly.",
      rules: [["Concrete", "Timelines, prices and facts instead of adjectives: \"72 hours\", not \"super fast\"."], ["No jargon", "We talk about the client's problems (selling online, saving time), not technologies."], ["Honest", "If something doesn't exist yet, we don't show it: no made-up cases or logos of clients we don't have."], ["A feline wink, sometimes", "The cat may appear on an error page or a success message. Never in prices, contracts or legal terms."]],
    },
    downloads: "Original files", files: [["Pink cat (SVG)", "mark.svg"], ["Charcoal cat (SVG)", "mark-dark.svg"], ["Charcoal wordmark (PNG)", "wordmark-dark.png"], ["Light wordmark (PNG)", "wordmark-light.png"]],
    copyHex: "Copy", copied: "Copied",
  },
}[lang];
const ids = ["logo", "color", "type", "imagery", "voice", "downloads"];
---
<Base lang={lang} title={copy.title} description={copy.description}>
  <header class="page-head">
    <div class="wrap">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1>{copy.h1}</h1>
      <p class="lead">{copy.lead}</p>
      <nav class="toc" aria-label={copy.eyebrow}>{copy.toc.map((label, i) => <a href={`#${ids[i]}`}>{label}</a>)}</nav>
    </div>
  </header>

  <section class="section" id="logo">
    <div class="wrap">
      <h2>{copy.toc[0]}</h2>
      <p class="lead">{copy.logo.intro}</p>
      <!-- One cat per view: the variants are shown one at a time. -->
      <div class="variants">
        <div class="switch" role="radiogroup">
          <input type="radio" name="variant" id="variant-light" checked /><label for="variant-light">{copy.logo.lightTab}</label>
          <input type="radio" name="variant" id="variant-dark" /><label for="variant-dark">{copy.logo.darkTab}</label>
        </div>
        <figure class="tile light"><div class="lockup"><img src={b("mark.svg")} width="76" height="60" alt="" /><img src={b("wordmark-dark.png")} width="261" height="33" alt="The Meowpany" /></div><figcaption>{copy.logo.light}</figcaption></figure>
        <figure class="tile dark"><div class="lockup"><img src={b("mark-dark.svg")} width="76" height="60" alt="" /><img src={b("wordmark-light.png")} width="261" height="33" alt="The Meowpany" /></div><figcaption>{copy.logo.dark}</figcaption></figure>
      </div>
      <div class="grid-2 rules">
        <ul class="check-list">{copy.logo.rules.map((r) => <li><span>{r}</span></li>)}</ul>
        <div><h3>{copy.logo.dontTitle}</h3><ul class="dont">{copy.logo.donts.map((r) => <li>{r}</li>)}</ul></div>
      </div>
    </div>
  </section>

  <section class="section soft" id="color">
    <div class="wrap">
      <h2>{copy.toc[1]}</h2>
      <p class="lead">{copy.colorsIntro}</p>
      <ul class="swatches">
        {colors.map((c) => (
          <li class="swatch">
            <div class="chip" style={`background:${c.hex};color:${c.ink}`}><span>{c.hex}</span></div>
            <div class="info"><strong>{c.name}</strong><p class="muted">{c.role[lang]}</p>
              <button type="button" class="copy" data-hex={c.hex} data-copied={copy.copied}>{copy.copyHex} {c.hex}</button></div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" id="type">
    <div class="wrap">
      <h2>{copy.toc[2]}</h2>
      <p class="lead">{copy.type.intro}</p>
      <div class="grid-2">
        <div class="card specimen"><p class="label">{copy.type.display}</p><p class="display">{copy.type.sample}</p><p class="glyphs display-glyphs">Aa Bb Cc 0123456789 USD 1.000</p></div>
        <div class="card specimen"><p class="label">{copy.type.text}</p><p class="body">{copy.type.body}</p><p class="glyphs">Aa Bb Cc Ññ Áá 0123456789</p></div>
      </div>
      <ul class="dash-list scale">{copy.type.scale.map((s) => <li>{s}</li>)}</ul>
    </div>
  </section>

  <section class="section soft" id="imagery">
    <div class="wrap narrow">
      <h2>{copy.toc[3]}</h2>
      <ul class="check-list">{copy.imagery.map((r) => <li><span>{r}</span></li>)}</ul>
    </div>
  </section>

  <section class="section" id="voice">
    <div class="wrap">
      <h2>{copy.toc[4]}</h2>
      <p class="lead">{copy.voice.intro}</p>
      <dl class="voice">{copy.voice.rules.map(([t, d]) => <div class="card"><dt>{t}</dt><dd class="muted">{d}</dd></div>)}</dl>
    </div>
  </section>

  <section class="section soft" id="downloads">
    <div class="wrap">
      <h2>{copy.toc[5]}</h2>
      <ul class="files">{copy.files.map(([label, file]) => <li><a class="card file" href={b(file)} download><span>{label}</span><span class="muted small">{file}</span></a></li>)}</ul>
    </div>
  </section>
</Base>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>("button.copy")) {
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.hex ?? "");
        const before = button.textContent;
        button.textContent = button.dataset.copied ?? "";
        setTimeout(() => { button.textContent = before; }, 1400);
      } catch { /* clipboard blocked: the code stays visible to copy by hand */ }
    });
  }
</script>

<style>
  .toc { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1.75rem; }
  .toc a { padding: 0.4rem 0.85rem; border-radius: 999px; border: 1px solid var(--line); background: var(--bg); color: var(--ink-2); text-decoration: none; font-size: 0.9rem; font-weight: 550; }
  .toc a:hover { border-color: var(--ink-2); color: var(--ink); }
  .variants { margin: 2rem 0; max-width: 720px; }
  .switch { display: inline-flex; padding: 4px; border-radius: 12px; background: var(--soft); border: 1px solid var(--line); margin-bottom: 1rem; }
  .switch input { position: absolute; opacity: 0; pointer-events: none; }
  .switch label { padding: 0.45rem 1rem; border-radius: 9px; font-size: 0.9rem; font-weight: 600; color: var(--muted); cursor: pointer; }
  .switch input:checked + label { background: var(--bg); color: var(--ink); box-shadow: var(--shadow-sm); }
  .switch input:focus-visible + label { outline: 2px solid var(--primary); outline-offset: 2px; }
  .variants:has(#variant-light:checked) .tile.dark, .variants:has(#variant-dark:checked) .tile.light { display: none; }
  .tile { margin: 0; border-radius: var(--radius-lg); border: 1px solid var(--line); overflow: hidden; }
  .tile .lockup { display: flex; align-items: center; justify-content: center; gap: 1rem; padding: 3.5rem 1.5rem; }
  .tile.light .lockup { background: #ffffff; }
  .tile.dark .lockup { background: #1d1b1f; }
  .tile figcaption { padding: 0.8rem 1rem; font-size: 0.9rem; color: var(--muted); border-top: 1px solid var(--line); }
  .rules { gap: 2rem; }
  .dont { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.55rem; }
  .dont li { padding-left: 1.6rem; position: relative; color: var(--ink-2); }
  .dont li::before { content: "×"; position: absolute; left: 0.2rem; top: -0.05rem; color: var(--error); font-weight: 700; font-size: 1.1rem; }
  .swatches { list-style: none; padding: 0; margin: 2rem 0 0; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr)); }
  .swatch { border: 1px solid var(--line); border-radius: var(--radius-lg); overflow: hidden; background: var(--bg); }
  .chip { height: 110px; display: flex; align-items: flex-end; padding: 0.75rem 1rem; font-family: var(--font-display); font-weight: 700; letter-spacing: 0.02em; }
  .info { padding: 1rem; }
  .info p { font-size: 0.9rem; margin: 0.25rem 0 0.75rem; }
  .copy { font: inherit; font-size: 0.82rem; font-weight: 600; padding: 0.3rem 0.7rem; border-radius: 8px; border: 1px solid var(--line-strong); background: var(--bg); color: var(--ink-2); cursor: pointer; }
  .specimen .label { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); font-weight: 650; }
  .specimen .display { font-family: var(--font-display); font-weight: 800; font-size: clamp(1.6rem, 3vw, 2.3rem); line-height: 1.1; color: var(--ink); }
  .specimen .body { font-size: 1.05rem; color: var(--ink-2); }
  .glyphs { color: var(--muted); font-size: 1.1rem; margin: 0; }
  .display-glyphs { font-family: var(--font-display); font-weight: 700; }
  .scale { margin-top: 1.5rem; }
  .voice { margin: 2rem 0 0; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); }
  .voice dt { font-family: var(--font-display); font-weight: 700; font-size: 1.15rem; margin-bottom: 0.35rem; }
  .voice dd { margin: 0; }
  .files { list-style: none; padding: 0; margin: 1.5rem 0 0; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); }
  .file { display: grid; gap: 0.25rem; text-decoration: none; color: var(--ink); font-weight: 600; font-size: 0.95rem; }
</style>

---
// Project estimator. The visitor describes the system in business terms and src/lib/estimator.ts
// turns the answers into function points, with the same rules and calibration the team uses in Core.
// If the visitor leaves an email, the proposal is also delivered to the team (src/lib/leads.ts).
import Base from "../../layouts/Base.astro";
import { path, type Lang } from "../../i18n";
import { inbox, services } from "../../site";

interface Props { lang: Lang }
const { lang } = Astro.props;
const copy = {
  es: {
    title: "Estimar mi proyecto", description: "Describa su sistema en palabras simples y reciba al instante una propuesta con alcance, plazo y rango de precio, calculada por puntos de función.",
    lead: "Describa qué tiene que hacer su sistema. Lo calculamos con el mismo método que usamos internamente (puntos de función, norma IFPUG) y le mostramos una propuesta con alcance, plazo y un rango de precio orientativo para su caso.",
    project: "Nombre del proyecto", projectHint: "Por ejemplo: Sistema de turnos",
    entities: "¿Qué información tiene que guardar el sistema?", entitiesHint: "Una por fila: clientes, turnos, productos, pedidos...",
    entityName: "Qué guarda", size: "Cuántos datos tiene cada uno", sizes: { few: "Pocos (hasta 5 campos)", some: "Varios (6 a 15)", many: "Muchos (más de 15)" },
    reports: "¿Qué informes o documentos tiene que producir?", reportsHint: "Facturas, reportes de ventas, certificados...",
    reportName: "Informe", complexity: "Complejidad", complexities: { low: "Simple", average: "Media", high: "Compleja" },
    integrations: "¿Con qué otros sistemas se conecta?", integrationsHint: "Facturación electrónica, Mercado Pago, WhatsApp, un ERP...",
    integrationName: "Sistema", add: "Agregar fila", remove: "Quitar",
    extras: "Además", payments: "Cobra en línea", notifications: "Envía avisos automáticos (correo o WhatsApp)",
    locations: "Se usa en varias sucursales", multilingual: "Funciona en más de un idioma",
    roles: "¿Cuántos tipos de usuario distintos? (por ejemplo, administrador y vendedor)",
    scale: "¿Cuánta gente lo usa a la vez?", scales: { small: "Pocas personas", medium: "Decenas", large: "Cientos o más" },
    logic: "¿Qué tan complejas son las reglas del negocio?", logics: { simple: "Simples", moderate: "Moderadas", complex: "Complejas (cálculos, aprobaciones)" },
    contact: "Para recibir la propuesta (opcional)", name: "Nombre", company: "Empresa", email: "Correo",
    submit: "Calcular mi propuesta", running: "Calculando...", fail: "No pudimos calcular la estimación.",
    proposal: "Propuesta", scope: "Alcance", functionsCaption: "Funciones del sistema y su peso en puntos de función",
    fn: "Función", type: "Tipo", weight: "Peso", size2: "Tamaño", effort: "Esfuerzo estimado", duration: "Duración estimada",
    price: "Rango de precio", points: "puntos de función", hours: "horas", weeks: "semanas con un equipo de 40 horas semanales",
    method: "Cómo se calculó",
    terms: "Condiciones", termsList: ["Es una estimación previa: el precio cerrado se fija después de una reunión de relevamiento.", "Antes de pagar nada, ve una primera versión funcional en 72 horas. Si no lo convence, no sigue y no paga.", "Si decide avanzar: 50 % al continuar y 50 % en la entrega; por hitos en los proyectos más grandes.", "Una demostración cada 2 semanas y garantía de 60 días.", "Clientes de Uruguay: + IVA."],
    sent: "También le enviamos esta propuesta a nuestro equipo: lo contactamos en menos de un día hábil.",
    drafted: "Abrimos su correo con la propuesta para enviárnosla. Así la revisamos con usted.",
    print: "Imprimir o guardar como PDF", book: "Agendar una llamada para cerrar el alcance", edit: "Modificar las respuestas",
    vat: "+ IVA",
  },
  en: {
    title: "Estimate my project", description: "Describe your system in plain words and get an instant proposal with scope, timeline and price range, computed with function points.",
    lead: "Describe what your system needs to do. We size it with the same method we use internally (IFPUG function points) and show you a proposal with scope, timeline and an indicative price range for your case.",
    project: "Project name", projectHint: "For example: Booking system",
    entities: "What information does the system store?", entitiesHint: "One per row: customers, bookings, products, orders...",
    entityName: "What it stores", size: "How much data each one has", sizes: { few: "Little (up to 5 fields)", some: "Some (6 to 15)", many: "A lot (over 15)" },
    reports: "What reports or documents does it produce?", reportsHint: "Invoices, sales reports, certificates...",
    reportName: "Report", complexity: "Complexity", complexities: { low: "Simple", average: "Average", high: "Complex" },
    integrations: "Which other systems does it connect to?", integrationsHint: "Payments, accounting, WhatsApp, an ERP...",
    integrationName: "System", add: "Add row", remove: "Remove",
    extras: "Also", payments: "Takes online payments", notifications: "Sends automatic notifications (email or WhatsApp)",
    locations: "Used across several locations", multilingual: "Works in more than one language",
    roles: "How many different kinds of user? (for example, admin and sales)",
    scale: "How many people use it at the same time?", scales: { small: "A few", medium: "Dozens", large: "Hundreds or more" },
    logic: "How complex are the business rules?", logics: { simple: "Simple", moderate: "Moderate", complex: "Complex (calculations, approvals)" },
    contact: "To receive the proposal (optional)", name: "Name", company: "Company", email: "Email",
    submit: "Calculate my proposal", running: "Calculating...", fail: "We couldn't calculate the estimate.",
    proposal: "Proposal", scope: "Scope", functionsCaption: "System functions and their weight in function points",
    fn: "Function", type: "Type", weight: "Weight", size2: "Size", effort: "Estimated effort", duration: "Estimated duration",
    price: "Price range", points: "function points", hours: "hours", weeks: "weeks with a 40-hour-a-week team",
    method: "How it was calculated",
    terms: "Terms", termsList: ["This is a preliminary estimate: the fixed price is set after a discovery meeting.", "Before paying anything, you see a first working version within 72 hours. If it doesn't convince you, you stop and pay nothing.", "If you go ahead: 50 % to continue and 50 % on delivery; milestones for larger projects.", "A demo every 2 weeks and a 60-day warranty."],
    sent: "We also sent this proposal to our team: we'll reach out within one business day.",
    drafted: "Your email app opened with the proposal, ready to send us so we can go through it with you.",
    print: "Print or save as PDF", book: "Book a call to settle the scope", edit: "Change the answers",
    vat: "",
  },
}[lang];
const rowText = { remove: copy.remove, sizes: copy.sizes, complexities: copy.complexities, entityName: copy.entityName, size: copy.size, reportName: copy.reportName, complexity: copy.complexity, integrationName: copy.integrationName };
---
<Base lang={lang} title={copy.title} description={copy.description}>
  <header class="page-head">
    <div class="wrap">
      <h1>{copy.title}</h1>
      <p class="lead">{copy.lead}</p>
    </div>
  </header>
  <section class="section">
    <div class="wrap">

      <form id="estimate-form" class="card" novalidate data-email={inbox("estimaciones")} data-inbox={services.web3formsKey}
        data-lang={lang} data-rows={JSON.stringify(rowText)}>
        <p><label>{copy.project}<br /><input name="project_name" required maxlength="150" placeholder={copy.projectHint} /></label></p>

        <fieldset data-list="entities">
          <legend>{copy.entities}</legend>
          <p><small>{copy.entitiesHint}</small></p>
          <ol data-rows></ol>
          <button type="button" class="btn btn-ghost" data-add>{copy.add}</button>
        </fieldset>

        <fieldset data-list="reports">
          <legend>{copy.reports}</legend>
          <p><small>{copy.reportsHint}</small></p>
          <ol data-rows></ol>
          <button type="button" class="btn btn-ghost" data-add>{copy.add}</button>
        </fieldset>

        <fieldset data-list="integrations">
          <legend>{copy.integrations}</legend>
          <p><small>{copy.integrationsHint}</small></p>
          <ol data-rows></ol>
          <button type="button" class="btn btn-ghost" data-add>{copy.add}</button>
        </fieldset>

        <fieldset>
          <legend>{copy.extras}</legend>
          <p><label><input type="checkbox" name="online_payments" /> {copy.payments}</label></p>
          <p><label><input type="checkbox" name="notifications" /> {copy.notifications}</label></p>
          <p><label><input type="checkbox" name="multiple_locations" /> {copy.locations}</label></p>
          <p><label><input type="checkbox" name="multilingual" /> {copy.multilingual}</label></p>
          <p><label>{copy.roles}<br /><input type="number" name="roles" min="1" max="20" value="1" inputmode="numeric" /></label></p>
          <p><label>{copy.scale}<br /><select name="scale">{Object.entries(copy.scales).map(([v, l]) => <option value={v} selected={v === "small"}>{l}</option>)}</select></label></p>
          <p><label>{copy.logic}<br /><select name="logic">{Object.entries(copy.logics).map(([v, l]) => <option value={v} selected={v === "moderate"}>{l}</option>)}</select></label></p>
        </fieldset>

        <fieldset>
          <legend>{copy.contact}</legend>
          <p><label>{copy.name}<br /><input name="name" autocomplete="name" maxlength="200" /></label></p>
          <p><label>{copy.company}<br /><input name="company" autocomplete="organization" maxlength="200" /></label></p>
          <p><label>{copy.email}<br /><input name="email" type="email" autocomplete="email" maxlength="254" /></label></p>
          <p hidden><label>Website<input name="website" tabindex="-1" autocomplete="off" /></label></p>
        </fieldset>

        <p><button class="btn btn-accent" type="submit">{copy.submit}</button></p>
        <p role="status" aria-live="polite" data-status></p>
      </form>

      <article id="proposal" hidden data-text={JSON.stringify(copy)} data-book={path("book", lang)}></article>
    </div>
  </section>
</Base>

<script>
  import { COMPLEXITY_LABELS, estimate, InvalidAnswers, KIND_LABELS, type Answers, type Estimate } from "../../lib/estimator";
  import { isBot, isEmail, leadSink } from "../../lib/leads";

  const form = document.getElementById("estimate-form") as HTMLFormElement;
  const output = document.getElementById("proposal") as HTMLElement;
  const status = form.querySelector<HTMLElement>("[data-status]")!;
  const rows = JSON.parse(form.dataset.rows!);
  const text = JSON.parse(output.dataset.text!);
  const lang = form.dataset.lang!;
  const money = (v: string | number) => `USD ${Number(v).toLocaleString(lang === "es" ? "es-UY" : "en-US", { maximumFractionDigits: 0 })}`;

  function el<K extends keyof HTMLElementTagNameMap>(tag: K, content?: string | Node[], attrs: Record<string, string> = {}) {
    const node = document.createElement(tag);
    for (const [key, value] of Object.entries(attrs)) node.setAttribute(key, value);
    if (typeof content === "string") node.textContent = content;
    else if (content) node.append(...content);
    return node;
  }

  function select(name: string, label: string, options: Record<string, string>, selected: string) {
    const control = el("select", Object.entries(options).map(([value, text]) => {
      const option = el("option", text, { value });
      if (value === selected) option.setAttribute("selected", "");
      return option;
    }), { name });
    return el("label", [document.createTextNode(`${label} `), control]);
  }

  // Each list starts with one row; "Add row" appends another of the same kind.
  function addRow(list: string, focus = true) {
    const container = form.querySelector(`[data-list=${list}] [data-rows]`)!;
    const nameLabel = { entities: rows.entityName, reports: rows.reportName, integrations: rows.integrationName }[list];
    const parts: Node[] = [el("label", [document.createTextNode(`${nameLabel} `), el("input", undefined, { name: "item", maxlength: "80" })])];
    if (list === "entities") parts.push(document.createTextNode(" "), select("size", rows.size, rows.sizes, "some"));
    if (list === "reports") parts.push(document.createTextNode(" "), select("complexity", rows.complexity, rows.complexities, "average"));
    const remove = el("button", rows.remove, { type: "button" });
    remove.addEventListener("click", () => item.remove());
    parts.push(document.createTextNode(" "), remove);
    const item = el("li", parts);
    container.append(item);
    if (focus) item.querySelector("input")?.focus();
  }

  for (const fieldset of form.querySelectorAll<HTMLElement>("[data-list]")) {
    const list = fieldset.dataset.list!;
    fieldset.querySelector("[data-add]")!.addEventListener("click", () => addRow(list));
    addRow(list, false);
  }

  function collect(list: string) {
    return [...form.querySelectorAll<HTMLLIElement>(`[data-list=${list}] li`)]
      .map((li) => ({
        name: li.querySelector<HTMLInputElement>("input[name=item]")!.value.trim(),
        size: li.querySelector<HTMLSelectElement>("select[name=size]")?.value,
        complexity: li.querySelector<HTMLSelectElement>("select[name=complexity]")?.value,
      }))
      .filter((item) => item.name);
  }

  type Proposal = Estimate & { reference: string; projectName: string };

  // A short reference the visitor and the team can quote, without a server to number proposals.
  const reference = () => {
    const now = new Date();
    const date = `${now.getFullYear()}${String(now.getMonth() + 1).padStart(2, "0")}${String(now.getDate()).padStart(2, "0")}`;
    return `P-${date}-${Math.random().toString(36).slice(2, 6).toUpperCase()}`;
  };

  function render(result: Proposal, note: string) {
    const language = lang === "es" ? "es" : "en";
    const number = (v: number) => v.toLocaleString(lang === "es" ? "es-UY" : "en-US");
    output.replaceChildren(
      el("h2", `${text.proposal} ${result.reference}: ${result.projectName}`),
      el("p", new Date().toLocaleDateString(lang === "es" ? "es-UY" : "en-US", { dateStyle: "long" })),
      el("table", [el("tbody", [
        el("tr", [el("th", text.size2, { scope: "row" }), el("td", `${number(result.adjustedPoints)} ${text.points}`)]),
        el("tr", [el("th", text.effort, { scope: "row" }), el("td", `${result.hours} ${text.hours}`)]),
        el("tr", [el("th", text.duration, { scope: "row" }), el("td", `${number(result.weeks)} ${text.weeks}`)]),
        el("tr", [el("th", text.price, { scope: "row" }), el("td", `${money(result.priceLow)} – ${money(result.priceHigh)} ${text.vat}`)]),
      ])]),
      el("h3", text.scope),
      el("table", [
        el("caption", text.functionsCaption),
        el("thead", [el("tr", [el("th", text.fn), el("th", text.type), el("th", text.weight)])]),
        el("tbody", result.functions.map((f) => el("tr", [
          el("td", f.name), el("td", `${KIND_LABELS[language][f.kind]} · ${COMPLEXITY_LABELS[language][f.complexity]}`), el("td", String(f.weight)),
        ]))),
      ]),
      el("h3", text.method),
      el("p", lang === "es"
        ? `${result.unadjustedPoints} puntos sin ajustar × factor de ajuste ${number(result.adjustmentFactor)} = ${number(result.adjustedPoints)} puntos ajustados. ${result.hours} horas estimadas.`
        : `${result.unadjustedPoints} unadjusted points × adjustment factor ${number(result.adjustmentFactor)} = ${number(result.adjustedPoints)} adjusted points. ${result.hours} estimated hours.`),
      el("h3", text.terms),
      el("ul", text.termsList.map((term: string) => el("li", term))),
      ...(note ? [el("p", note, { class: "notice" })] : []),
      el("p", [
        el("button", text.print, { type: "button", class: "btn btn-accent", "data-print": "" }), document.createTextNode(" "),
        el("a", text.book, { href: output.dataset.book!, class: "btn btn-ghost" }), document.createTextNode(" "),
        el("button", text.edit, { type: "button", class: "btn btn-ghost", "data-edit": "" }),
      ]),
    );
    output.hidden = false;
    form.hidden = true;
    output.querySelector("[data-print]")!.addEventListener("click", () => window.print());
    output.querySelector("[data-edit]")!.addEventListener("click", () => { output.hidden = true; form.hidden = false; });
    output.querySelector("h2")!.setAttribute("tabindex", "-1");
    output.querySelector<HTMLElement>("h2")!.focus();
  }

  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (isBot(form)) return;
    const data = new FormData(form);
    const projectName = String(data.get("project_name") ?? "").trim().slice(0, 150);
    if (!projectName) return form.querySelector<HTMLInputElement>("input[name=project_name]")!.focus();
    const answers: Answers = {
      entities: collect("entities"), reports: collect("reports"), integrations: collect("integrations"),
      online_payments: data.has("online_payments"), notifications: data.has("notifications"),
      multiple_locations: data.has("multiple_locations"), multilingual: data.has("multilingual"),
      roles: Number(data.get("roles") || 1), scale: String(data.get("scale")), logic: String(data.get("logic")),
    };
    let result: Proposal;
    try {
      result = { ...estimate(answers, lang === "es" ? "es" : "en"), reference: reference(), projectName };
    } catch (error) {
      status.textContent = error instanceof InvalidAnswers && error.fields.entities === "required" ? text.entities : text.fail;
      return;
    }
    status.textContent = "";

    let note = "";
    const email = String(data.get("email") ?? "").trim();
    if (isEmail(email)) {
      const sink = leadSink({ web3formsKey: form.dataset.inbox ?? "", email: form.dataset.email ?? "" });
      const delivery = await sink.send({
        kind: "estimate", language: lang, name: String(data.get("name") ?? "").trim() || email, email,
        company: String(data.get("company") ?? ""),
        details: {
          Proposal: result.reference, Project: projectName, "Adjusted points": result.adjustedPoints, Hours: result.hours,
          "Price range (USD)": `${result.priceLow} - ${result.priceHigh}`,
          Stores: answers.entities.map((e) => `${e.name} (${e.size})`).join(", "),
          Reports: answers.reports.map((r) => `${r.name} (${r.complexity})`).join(", "),
          Integrations: answers.integrations.map((i) => i.name).join(", "),
          Extras: Object.entries({ payments: answers.online_payments, notifications: answers.notifications, locations: answers.multiple_locations, multilingual: answers.multilingual })
            .filter(([, on]) => on).map(([key]) => key).join(", "),
          Roles: answers.roles, Scale: answers.scale, Logic: answers.logic,
        },
      });
      note = delivery === "sent" ? text.sent : text.drafted;
    }
    render(result, note);
  });
</script>

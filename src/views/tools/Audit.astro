---
// Free website audit. The visitor's browser asks Google PageSpeed Insights to run Lighthouse on the
// site (src/lib/audit.ts) and this page renders the report. If the visitor leaves an email, the
// summary also reaches the team (src/lib/leads.ts).
import Base from "../../layouts/Base.astro";
import { path, type Lang } from "../../i18n";
import { inbox, services } from "../../site";

interface Props { lang: Lang }
const { lang } = Astro.props;
const copy = {
  es: {
    title: "Auditoría web gratuita", description: "Analice su sitio en un minuto: velocidad, accesibilidad, buenas prácticas y posicionamiento en Google en celulares, con las correcciones ordenadas por impacto.",
    lead: "Escriba la dirección de su sitio. En menos de un minuto recibe un informe con lo que está bien, lo que falla y qué corregir primero.",
    url: "Dirección del sitio", urlHint: "Por ejemplo: mitienda.com.uy", email: "Correo (opcional)", emailHint: "Si lo deja, le enviamos el resumen a nuestro equipo y lo ayudamos con las correcciones.",
    submit: "Analizar mi sitio", running: "Analizando su sitio en un celular simulado... puede tardar hasta un minuto.",
    invalid: "Escriba una dirección válida, por ejemplo mitienda.com.uy.",
    score: "Puntaje general", fixes: "Qué corregir primero", passed: "Lo que ya está bien", impact: { 3: "Impacto alto", 2: "Impacto medio", 1: "Impacto bajo" },
    status: { fail: "Falla", warn: "Mejorable", pass: "Bien" }, value: "Valor medido", noFixes: "No encontramos nada importante para corregir. ¡Buen trabajo!",
    share: "Enlace para repetir este análisis", cta: "¿Quiere que lo corrijamos por usted?", ctaText: "Cotice la corrección o agende una llamada de 30 minutos para revisar el informe juntos.",
    quote: "Cotizar la corrección", book: "Agendar una llamada", again: "Analizar otro sitio",
    fail: "No pudimos analizar ese sitio. Compruebe la dirección y que el sitio esté en línea.", busy: "El servicio de análisis está muy ocupado en este momento. Pruebe de nuevo en unos minutos o escríbanos a",
    measured: "Medido el", method: "Análisis hecho con Google PageSpeed Insights (Lighthouse) en un celular simulado. Los valores pueden variar un poco entre mediciones.",
    sent: "Le enviamos el resumen a nuestro equipo.", drafted: "Abrimos su correo con el resumen para enviárnoslo.",
  },
  en: {
    title: "Free website audit", description: "Check your site in a minute: speed, accessibility, best practices and search visibility on phones, with fixes ranked by impact.",
    lead: "Type your site's address. In under a minute you get a report of what works, what fails and what to fix first.",
    url: "Website address", urlHint: "For example: mystore.com", email: "Email (optional)", emailHint: "If you leave it, we send the summary to our team and help you with the fixes.",
    submit: "Audit my site", running: "Auditing your site on a simulated phone... this can take up to a minute.",
    invalid: "Type a valid address, for example mystore.com.",
    score: "Overall score", fixes: "What to fix first", passed: "Already in good shape", impact: { 3: "High impact", 2: "Medium impact", 1: "Low impact" },
    status: { fail: "Fails", warn: "Could improve", pass: "Good" }, value: "Measured value", noFixes: "We found nothing important to fix. Well done!",
    share: "Link to run this audit again", cta: "Want us to fix it for you?", ctaText: "Get a quote for the fixes or book a 30-minute call to go through the report together.",
    quote: "Get a quote", book: "Book a call", again: "Audit another site",
    fail: "We couldn't audit that site. Check the address and that the site is online.", busy: "The audit service is very busy right now. Try again in a few minutes or email us at",
    measured: "Measured on", method: "Audit run with Google PageSpeed Insights (Lighthouse) on a simulated phone. Values can vary slightly between runs.",
    sent: "We sent the summary to our team.", drafted: "Your email app opened with the summary, ready to send us.",
  },
}[lang];
---
<Base lang={lang} title={copy.title} description={copy.description}>
  <header class="page-head">
    <div class="wrap">
      <h1>{copy.title}</h1>
      <p class="lead">{copy.lead}</p>
    </div>
  </header>
  <section class="section">
    <div class="wrap">

      <form id="audit-form" class="card" novalidate
        data-lang={lang} data-key={services.pagespeedKey} data-inbox={services.web3formsKey} data-email={inbox("auditorias")}
        data-text={JSON.stringify(copy)} data-quote={path("quote", lang)} data-book={path("book", lang)}>
        <p><label>{copy.url}<br /><input name="url" type="text" inputmode="url" autocomplete="url" required placeholder={copy.urlHint} maxlength="500" /></label></p>
        <p><label>{copy.email}<br /><input name="email" type="email" autocomplete="email" maxlength="254" /></label><br /><small>{copy.emailHint}</small></p>
        <p hidden><label>Website<input name="website" tabindex="-1" autocomplete="off" /></label></p>
        <p><button class="btn btn-accent" type="submit">{copy.submit}</button></p>
        <p role="status" aria-live="polite" data-status></p>
        <p><small>{copy.method}</small></p>
      </form>

      <article id="audit-report" hidden aria-live="polite"></article>
    </div>
  </section>
</Base>

<script>
  import { normalizeUrl, runAudit, type Report } from "../../lib/audit";
  import { isBot, isEmail, leadSink } from "../../lib/leads";

  const form = document.getElementById("audit-form") as HTMLFormElement;
  const output = document.getElementById("audit-report") as HTMLElement;
  const status = form.querySelector<HTMLElement>("[data-status]")!;
  const input = form.querySelector<HTMLInputElement>("input[name=url]")!;
  const button = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
  const text = JSON.parse(form.dataset.text!);
  const lang = form.dataset.lang!;

  // Builds DOM nodes from text only, so nothing from the audited site can inject markup.
  function el<K extends keyof HTMLElementTagNameMap>(tag: K, content?: string | Node[], attrs: Record<string, string> = {}) {
    const node = document.createElement(tag);
    for (const [key, value] of Object.entries(attrs)) node.setAttribute(key, value);
    if (typeof content === "string") node.textContent = content;
    else if (content) node.append(...content);
    return node;
  }

  function render(report: Report, note: string) {
    const passed = report.checks.filter((c) => c.status === "pass");
    const shareUrl = `${location.origin}${location.pathname}?url=${encodeURIComponent(report.url)}`;

    output.replaceChildren(
      el("h2", report.url),
      el("p", `${text.measured} ${new Date(report.created).toLocaleString(lang === "es" ? "es-UY" : "en-US")}`),
      el("p", [el("strong", `${text.score}: ${report.score}/100`)]),
      el("table", [
        el("tbody", Object.entries(report.categories).map(([key, value]) =>
          el("tr", [el("th", report.categoryLabels[key] ?? key, { scope: "row" }), el("td", `${value}/100`)]))),
      ]),
      el("h2", text.fixes),
      report.fixes.length
        ? el("ol", report.fixes.map((c) => el("li", [
          el("h3", `${c.title}: ${text.status[c.status]}`),
          el("p", `${text.impact[c.impact]} · ${report.categoryLabels[c.category] ?? c.category}${c.value ? ` · ${text.value}: ${c.value}` : ""}`),
          el("p", c.fix),
        ])))
        : el("p", text.noFixes),
      el("details", [el("summary", `${text.passed} (${passed.length})`),
        el("ul", passed.map((c) => el("li", `${c.title}${c.value ? `: ${c.value}` : ""}`)))]),
      ...(note ? [el("p", note, { class: "notice" })] : []),
      el("p", [el("label", [document.createTextNode(`${text.share}: `), el("input", undefined, { type: "text", readonly: "", value: shareUrl, size: "60" })])]),
      el("h2", text.cta),
      el("p", text.ctaText),
      el("p", [el("a", text.quote, { href: form.dataset.quote!, class: "btn btn-accent" }), document.createTextNode(" "),
        el("a", text.book, { href: form.dataset.book!, class: "btn btn-ghost" })]),
      el("p", [el("button", text.again, { type: "button", class: "btn btn-ghost", "data-again": "" })]),
    );
    output.hidden = false;
    form.hidden = true;
    history.replaceState(null, "", `?url=${encodeURIComponent(report.url)}`);
    output.querySelector("[data-again]")?.addEventListener("click", () => {
      output.hidden = true; form.hidden = false; history.replaceState(null, "", location.pathname);
      input.focus();
    });
    output.querySelector("h2")?.setAttribute("tabindex", "-1");
    output.querySelector<HTMLElement>("h2")?.focus();
  }

  function showError(error: unknown) {
    const busy = (error as { status?: number })?.status === 429;
    if (!busy) return void (status.textContent = text.fail);
    const link = el("a", form.dataset.email!, { href: `mailto:${form.dataset.email}` });
    status.replaceChildren(`${text.busy} `, link, ".");
  }

  async function audit(url: string) {
    button.disabled = true;
    status.textContent = text.running;
    try {
      const report = await runAudit(url, lang, form.dataset.key ?? "");
      status.textContent = "";
      let note = "";
      const email = String(new FormData(form).get("email") ?? "").trim();
      if (isEmail(email)) {
        const delivery = await leadSink({ web3formsKey: form.dataset.inbox ?? "", email: form.dataset.email ?? "" }).send({
          kind: "audit", language: lang, name: email, email,
          details: {
            Site: report.url, Score: report.score,
            ...Object.fromEntries(Object.entries(report.categories).map(([key, value]) => [report.categoryLabels[key] ?? key, value])),
            "Top fixes": report.fixes.slice(0, 5).map((c) => c.title).join("; "),
          },
        });
        note = delivery === "sent" ? text.sent : text.drafted;
      }
      render(report, note);
    } catch (error) {
      showError(error);
    } finally {
      button.disabled = false;
    }
  }

  form.addEventListener("submit", (event) => {
    event.preventDefault();
    if (isBot(form)) return;
    const url = normalizeUrl(input.value);
    if (!url) {
      status.textContent = text.invalid;
      return input.focus();
    }
    void audit(url);
  });

  // A shared link (?url=...) runs the audit again for the same site.
  const shared = normalizeUrl(new URLSearchParams(location.search).get("url") ?? "");
  if (shared) {
    input.value = shared;
    void audit(shared);
  }
</script>

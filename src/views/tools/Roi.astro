---
// Return-on-investment calculator. Runs entirely in the browser with the tested function in lib/roi.ts.
import Base from "../../layouts/Base.astro";
import { path, type Lang } from "../../i18n";

interface Props { lang: Lang }
const { lang } = Astro.props;
const copy = {
  es: {
    title: "Calcular el retorno", description: "Calcule cuánto le cuesta hoy trabajar a mano y en cuántos meses se paga un sistema o una tienda en línea.",
    lead: "Cuánto le cuesta hoy hacer las cosas a mano, y en cuántos meses se paga el software que lo resuelve. El cálculo ocurre en su navegador: no se envía ningún dato.",
    today: "Cómo trabaja hoy", hours: "Horas por semana que su equipo dedica a tareas que el software haría solo", cost: "Costo de una hora de ese equipo (USD)",
    errors: "Errores por mes por trabajar a mano (pedidos mal cargados, turnos perdidos...)", errorCost: "Lo que cuesta cada error (USD)",
    sales: "Margen de las ventas que pierde por mes (por ejemplo, por no vender en línea) (USD)",
    solution: "La inversión", price: "Inversión que está evaluando (USD)", support: "Costo mensual de soporte, si lo hay (USD)",
    investmentHint: "Use el monto de su cotización o de cualquier presupuesto que esté comparando.",
    result: "Resultado", loss: "Lo que pierde hoy por mes", net: "Ahorro neto por mes (después del soporte)", payback: "Se paga en",
    months: "meses", never: "Con estos números, el proyecto no se paga: el ahorro no cubre el soporte.", net12: "Ganancia neta en 12 meses", net36: "Ganancia neta en 36 meses",
    breakdown: "De dónde sale la pérdida", time: "Tiempo del equipo", errorsLabel: "Errores", salesLabel: "Ventas perdidas",
    cta: "Estimar mi proyecto con precisión", book: "Agendar una llamada",
  },
  en: {
    title: "Calculate the return", description: "See what manual work costs you today and how many months a system or online store takes to pay for itself.",
    lead: "What doing things by hand costs you today, and how many months the software that fixes it takes to pay for itself. The math runs in your browser: no data is sent.",
    today: "How you work today", hours: "Hours a week your team spends on work software would do", cost: "Cost of one hour of that team (USD)",
    errors: "Mistakes a month caused by manual work (wrong orders, lost bookings...)", errorCost: "What each mistake costs (USD)",
    sales: "Margin on sales lost each month (for example, from not selling online) (USD)",
    solution: "The investment", price: "Investment you are weighing (USD)", support: "Monthly support cost, if any (USD)",
    investmentHint: "Use the figure from your quote, or from any proposal you are comparing.",
    result: "Result", loss: "What you lose each month today", net: "Net monthly savings (after support)", payback: "Pays for itself in",
    months: "months", never: "With these numbers the project doesn't pay off: savings don't cover support.", net12: "Net gain over 12 months", net36: "Net gain over 36 months",
    breakdown: "Where the loss comes from", time: "Team time", errorsLabel: "Mistakes", salesLabel: "Lost sales",
    cta: "Estimate my project precisely", book: "Book a call",
  },
}[lang];
---
<Base lang={lang} title={copy.title} description={copy.description}>
  <header class="page-head">
    <div class="wrap">
      <h1>{copy.title}</h1>
      <p class="lead">{copy.lead}</p>
    </div>
  </header>
  <section class="section">
    <div class="wrap layout">
      <form id="roi-form" class="card" data-lang={lang} data-text={JSON.stringify(copy)}>
        <fieldset>
          <legend>{copy.today}</legend>
          <p><label>{copy.hours}<br /><input type="number" name="hoursLostPerWeek" min="0" step="0.5" value="10" inputmode="decimal" /></label></p>
          <p><label>{copy.cost}<br /><input type="number" name="hourlyCost" min="0" step="0.5" value="6" inputmode="decimal" /></label></p>
          <p><label>{copy.errors}<br /><input type="number" name="errorsPerMonth" min="0" value="4" inputmode="numeric" /></label></p>
          <p><label>{copy.errorCost}<br /><input type="number" name="costPerError" min="0" value="25" inputmode="decimal" /></label></p>
          <p><label>{copy.sales}<br /><input type="number" name="salesLostPerMonth" min="0" value="300" inputmode="decimal" /></label></p>
        </fieldset>
        <fieldset>
          <legend>{copy.solution}</legend>
          <p class="muted">{copy.investmentHint}</p>
          <p><label>{copy.price}<br /><input type="number" name="projectPrice" min="0" value="2000" inputmode="decimal" /></label></p>
          <p><label>{copy.support}<br /><input type="number" name="monthlySupport" min="0" value="0" inputmode="decimal" /></label></p>
        </fieldset>
      </form>

      <section class="card result" aria-labelledby="roi-result-title" aria-live="polite">
        <h2 id="roi-result-title">{copy.result}</h2>
        <div class="payback"><span>{copy.payback}</span><strong data-out="payback"></strong></div>
        <dl>
          <div><dt>{copy.loss}</dt><dd data-out="monthlyLoss"></dd></div>
          <div><dt>{copy.net}</dt><dd data-out="monthlyNet"></dd></div>
          <div><dt>{copy.net12}</dt><dd data-out="net12"></dd></div>
          <div><dt>{copy.net36}</dt><dd data-out="net36"></dd></div>
        </dl>
        <h3>{copy.breakdown}</h3>
        <dl class="breakdown">
          <div><dt>{copy.time}</dt><dd data-out="time"></dd></div>
          <div><dt>{copy.errorsLabel}</dt><dd data-out="errors"></dd></div>
          <div><dt>{copy.salesLabel}</dt><dd data-out="sales"></dd></div>
        </dl>
        <div class="actions"><a class="btn btn-primary" href={path("estimate", lang)}>{copy.cta}</a><a class="btn btn-ghost" href={path("book", lang)}>{copy.book}</a></div>
      </section>
    </div>
  </section>
</Base>
<style>
  .layout { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 1.5rem; align-items: start; }
  .layout > form { max-width: none; margin: 0; }
  .result { position: sticky; top: 88px; }
  .result h2 { font-size: 1.3rem; margin: 0 0 1rem; }
  .payback { display: grid; gap: 0.2rem; padding: 0 0 1.1rem; margin-bottom: 0.25rem; border-bottom: 1px solid var(--line); }
  .payback span { font-size: 0.9rem; color: var(--ink-2); }
  .payback strong { font-family: var(--font-display); font-size: clamp(1.6rem, 3vw, 2.1rem); font-weight: 800; color: var(--primary); line-height: 1.15; }
  dl { margin: 0; }
  dl div { display: flex; justify-content: space-between; gap: 1rem; padding: 0.65rem 0; border-bottom: 1px solid var(--line); }
  dt { color: var(--ink-2); font-size: 0.95rem; }
  dd { margin: 0; font-weight: 650; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .result h3 { margin: 1.25rem 0 0.25rem; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.07em; color: var(--muted); }
  .breakdown div:last-child { border-bottom: 0; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 1.25rem; }
  @media (max-width: 900px) { .layout { grid-template-columns: minmax(0, 1fr); } .result { position: static; } }
</style>

<script>
  import { roi, type RoiInput } from "../../lib/roi";

  const form = document.getElementById("roi-form") as HTMLFormElement;
  const text = JSON.parse(form.dataset.text!);
  const lang = form.dataset.lang!;
  const money = (n: number) => `USD ${n.toLocaleString(lang === "es" ? "es-UY" : "en-US", { maximumFractionDigits: 0 })}`;
  const out = (key: string, value: string) => { document.querySelector(`[data-out=${key}]`)!.textContent = value; };

  function update() {
    const value = (name: keyof RoiInput) => Number((form.elements.namedItem(name) as HTMLInputElement).value);
    const result = roi({
      hoursLostPerWeek: value("hoursLostPerWeek"), hourlyCost: value("hourlyCost"), errorsPerMonth: value("errorsPerMonth"),
      costPerError: value("costPerError"), salesLostPerMonth: value("salesLostPerMonth"),
      projectPrice: value("projectPrice"), monthlySupport: value("monthlySupport"),
    });
    out("monthlyLoss", money(result.monthlyLoss));
    out("monthlyNet", money(result.monthlyNet));
    out("payback", result.paybackMonths === null ? text.never : `${result.paybackMonths.toLocaleString(lang === "es" ? "es-UY" : "en-US")} ${text.months}`);
    out("net12", money(result.net12));
    out("net36", money(result.net36));
    out("time", money(result.breakdown.time));
    out("errors", money(result.breakdown.errors));
    out("sales", money(result.breakdown.sales));
  }

  form.addEventListener("input", update);
  update();
</script>

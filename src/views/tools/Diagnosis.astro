---
// The 2-minute diagnosis: one question at a time, scored in the browser by src/lib/diagnosis.ts.
// Nothing is sent anywhere; the result ends in a concrete next step.
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import { path, type Lang } from "../../i18n";
import { withBase } from "../../lib/url";

interface Props { lang: Lang }
const { lang } = Astro.props;
const copy = {
  es: {
    title: "Diagnóstico de 2 minutos", description: "Cinco preguntas sobre cómo trabaja hoy su negocio y una recomendación concreta: sitio web, tienda en línea, software a medida, soporte o desarrolladores.",
    lead: "Cinco preguntas sobre cómo trabaja hoy. Al final le decimos por dónde le conviene empezar y por qué. Las respuestas se calculan en su navegador: no se envía nada.",
    step: "Pregunta {n} de {total}", back: "Atrás", restart: "Volver a empezar",
    questions: [
      { id: "sell", title: "¿Cómo vende o atiende hoy?", options: { social: "Por redes sociales y WhatsApp", shop: "En un local, sin sitio web propio", online: "Ya tengo un sitio o una tienda en línea", appointments: "Con turnos, reservas o agenda", b2b: "A otras empresas, por proyecto o contrato", team: "Somos un equipo de software y necesitamos más manos" } },
      { id: "time", title: "¿Qué le quita más tiempo?", options: { questions: "Responder siempre las mismas consultas", orders: "Cargar pedidos y cobros a mano", schedule: "Coordinar turnos y la agenda", sheets: "Planillas, informes y papeles", upkeep: "Mantener al día lo que ya tengo", backlog: "Tareas de desarrollo que se atrasan" } },
      { id: "goal", title: "¿Qué quiere lograr en los próximos 6 meses?", options: { found: "Que me encuentren en Google", sell: "Vender en línea", order: "Ordenar la operación", grow: "Crecer sin sumar personal", capacity: "Sumar capacidad a mi equipo" } },
      { id: "today", title: "¿Qué tiene hoy?", options: { nothing: "Nada propio, solo redes sociales", old: "Un sitio web desactualizado", store: "Una tienda en línea", system: "Un sistema propio o planillas complejas" } },
      { id: "when", title: "¿Para cuándo lo necesita?", options: { now: "Este mes", quarter: "En los próximos 3 meses", exploring: "Todavía estoy averiguando" } },
    ],
    recommend: "Le recomendamos", because: "Por qué", also: "También le puede servir",
    needs: {
      website: { title: "Un sitio web institucional", text: "Un sitio propio, rápido y fácil de encontrar en Google, que responda las preguntas frecuentes por usted y convierta visitas en consultas." },
      store: { title: "Una tienda en línea", text: "Ventas las 24 horas con pagos, envíos y facturación electrónica conectados, para dejar de cargar cada pedido a mano." },
      custom: { title: "Software a medida", text: "Un sistema que reemplace planillas y papeles: turnos, gestión, un portal para sus clientes o la integración de lo que ya usa." },
      support: { title: "Un plan de soporte", text: "Un equipo que mantiene al día lo que ya tiene, responde con plazos escritos y le dedica horas de mejoras cada mes." },
      hours: { title: "Desarrolladores para su equipo", text: "Desarrolladores que se suman a su equipo, en su horario y con sus herramientas, por hora o con dedicación completa." },
    },
    next: {
      prototype: { title: "Véalo funcionando en 72 horas", text: "Como lo necesita pronto, el mejor paso es una primera versión funcional: la ve antes de pagar nada.", cta: "Pedir la primera versión gratis", href: `${path("book", "es")}?for=prototype` },
      call: { title: "Hablemos 30 minutos", text: "Con unos meses por delante, una llamada alcanza para definir el alcance y el plazo.", cta: "Agendar una llamada", href: path("book", "es") },
      explore: { title: "Infórmese a su ritmo", text: "Si todavía está averiguando, la guía le explica qué hace falta para vender en línea en Uruguay, paso a paso.", cta: "Descargar la guía gratis", href: withBase("/guia/") },
    },
    service: "Ver qué incluye",
  },
  en: {
    title: "2-minute diagnosis", description: "Five questions about how your business works today and a concrete recommendation: website, online store, custom software, support or developers.",
    lead: "Five questions about how you work today. At the end we tell you where it makes sense to start, and why. Your answers are computed in your browser: nothing is sent.",
    step: "Question {n} of {total}", back: "Back", restart: "Start over",
    questions: [
      { id: "sell", title: "How do you sell or serve customers today?", options: { social: "Through social media and WhatsApp", shop: "In a shop, with no website of my own", online: "I already have a website or online store", appointments: "With appointments or bookings", b2b: "To other businesses, by project or contract", team: "We're a software team that needs more hands" } },
      { id: "time", title: "What takes up most of your time?", options: { questions: "Answering the same questions over and over", orders: "Entering orders and payments by hand", schedule: "Juggling appointments and the calendar", sheets: "Spreadsheets, reports and paperwork", upkeep: "Keeping what I have up to date", backlog: "Development work that keeps slipping" } },
      { id: "goal", title: "What do you want to achieve in the next 6 months?", options: { found: "Be found on Google", sell: "Sell online", order: "Get operations in order", grow: "Grow without hiring", capacity: "Add capacity to my team" } },
      { id: "today", title: "What do you have today?", options: { nothing: "Nothing of my own, just social media", old: "An outdated website", store: "An online store", system: "A system of my own or complex spreadsheets" } },
      { id: "when", title: "When do you need it?", options: { now: "This month", quarter: "In the next 3 months", exploring: "I'm still looking around" } },
    ],
    recommend: "We recommend", because: "Why", also: "Also worth a look",
    needs: {
      website: { title: "A business website", text: "A fast website you own, easy to find on Google, that answers common questions for you and turns visits into enquiries." },
      store: { title: "An online store", text: "Sell around the clock with payments, shipping and invoicing connected, instead of entering every order by hand." },
      custom: { title: "Custom software", text: "A system that replaces spreadsheets and paperwork: bookings, back office, a customer portal or connecting what you already use." },
      support: { title: "A support plan", text: "A team that keeps what you have up to date, replies within written times and spends improvement hours on it every month." },
      hours: { title: "Developers for your team", text: "Developers who join your team, in your hours and with your tools, by the hour or full time." },
    },
    next: {
      prototype: { title: "See it working within 72 hours", text: "Since you need it soon, the best step is a first working version: you see it before paying anything.", cta: "Ask for the free first version", href: `${path("book", "en")}?for=prototype` },
      call: { title: "Let's talk for 30 minutes", text: "With a few months ahead, one call is enough to settle the scope and timeline.", cta: "Book a call", href: path("book", "en") },
      explore: { title: "Take your time", text: "If you're still looking around, the estimator gives you scope, timeline and a price range for your case.", cta: "Estimate my project", href: path("estimate", "en") },
    },
    service: "See what's included",
  },
}[lang];
const anchor = (need: string) => (need === "hours" ? "exterior" : need);
const serviceLinks = Object.fromEntries(["website", "store", "custom", "support", "hours"].map((need) => [need, `${path("services", lang)}#${anchor(need)}`]));
---
<Base lang={lang} title={copy.title} description={copy.description}>
  <header class="page-head">
    <div class="wrap">
      <h1>{copy.title}</h1>
      <p class="lead">{copy.lead}</p>
    </div>
  </header>
  <section class="section">
    <div class="wrap">
      <div class="quiz card" data-quiz data-text={JSON.stringify({ recommend: copy.recommend, step: copy.step, questions: copy.questions, needs: copy.needs, next: copy.next })} data-links={JSON.stringify(serviceLinks)}>
        <div class="progress">
          <p class="progress-label" data-progress aria-live="polite"></p>
          <div class="bars" aria-hidden="true">{copy.questions.map(() => <span></span>)}</div>
        </div>
        {copy.questions.map((question, index) => (
          <fieldset data-question={question.id} hidden={index > 0}>
            <legend>{question.title}</legend>
            <div class="answers">
              {Object.entries(question.options).map(([value, label]) => (
                <label class="answer"><input type="radio" name={question.id} value={value} /><span>{label}</span><Icon name="arrow-right" /></label>
              ))}
            </div>
          </fieldset>
        ))}
        <div class="controls"><button type="button" class="btn btn-ghost btn-sm" data-back hidden>{copy.back}</button></div>

        <div class="result" data-result hidden>
          <h2 data-need-title></h2>
          <p class="lead" data-need-text></p>
          <h3>{copy.because}</h3>
          <ul class="check-list" data-reasons></ul>
          <div class="next">
            <div>
              <strong data-next-title></strong>
              <p class="muted" data-next-text></p>
            </div>
            <div class="next-actions">
              <a class="btn btn-primary" data-next-cta></a>
              <a class="btn btn-ghost" data-service>{copy.service}</a>
            </div>
          </div>
          <p class="also muted"><span>{copy.also}:</span> <a data-also></a></p>
          <button type="button" class="btn btn-ghost btn-sm" data-restart>{copy.restart}</button>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  import { diagnose, type Question } from "../../lib/diagnosis";

  const root = document.querySelector<HTMLElement>("[data-quiz]")!;
  const text = JSON.parse(root.dataset.text!);
  const links: Record<string, string> = JSON.parse(root.dataset.links!);
  const steps = [...root.querySelectorAll<HTMLFieldSetElement>("fieldset[data-question]")];
  const back = root.querySelector<HTMLButtonElement>("[data-back]")!;
  const result = root.querySelector<HTMLElement>("[data-result]")!;
  const progress = root.querySelector<HTMLElement>("[data-progress]")!;
  const bars = [...root.querySelectorAll<HTMLElement>(".bars span")];
  const $ = <T extends HTMLElement = HTMLElement>(selector: string) => root.querySelector<T>(selector)!;
  let step = 0;

  const show = (index: number) => {
    step = index;
    const done = step >= steps.length;
    steps.forEach((fieldset, i) => (fieldset.hidden = i !== step));
    bars.forEach((bar, i) => bar.classList.toggle("on", i < step || (!done && i === step)));
    back.hidden = step === 0 || done;
    progress.hidden = done;
    progress.textContent = text.step.replace("{n}", String(step + 1)).replace("{total}", String(steps.length));
    result.hidden = !done;
    if (done) render();
    else steps[step].querySelector<HTMLInputElement>("input:checked, input")?.focus({ preventScroll: true });
  };

  const answers = () => Object.fromEntries(steps.map((fieldset) => {
    const id = fieldset.dataset.question!;
    return [id, fieldset.querySelector<HTMLInputElement>("input:checked")?.value ?? ""];
  })) as Record<Question, string>;

  function render() {
    const diagnosis = diagnose(answers());
    const need = text.needs[diagnosis.need];
    $("[data-need-title]").textContent = `${text.recommend} ${need.title.charAt(0).toLowerCase()}${need.title.slice(1)}`;
    $("[data-need-text]").textContent = need.text;
    const list = $("[data-reasons]");
    list.replaceChildren(...diagnosis.reasons.map(({ question, answer }) => {
      const q = text.questions.find((item: { id: string }) => item.id === question);
      const li = document.createElement("li");
      const span = document.createElement("span");
      span.textContent = `${q.title} ${q.options[answer]}.`;
      li.append(span);
      return li;
    }));
    const next = text.next[diagnosis.next];
    $("[data-next-title]").textContent = next.title;
    $("[data-next-text]").textContent = next.text;
    const cta = $<HTMLAnchorElement>("[data-next-cta]");
    cta.textContent = next.cta;
    cta.href = next.href;
    $<HTMLAnchorElement>("[data-service]").href = links[diagnosis.need];
    const second = diagnosis.ranking[1];
    const also = $<HTMLAnchorElement>("[data-also]");
    also.textContent = text.needs[second.need].title;
    also.href = links[second.need];
    also.parentElement!.hidden = second.score === 0;
    result.scrollIntoView({ behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth", block: "start" });
  }

  root.addEventListener("change", (event) => {
    const input = event.target as HTMLInputElement;
    if (input.type !== "radio") return;
    // A short pause lets the choice register visually before the next question.
    window.setTimeout(() => show(step + 1), 220);
  });
  back.addEventListener("click", () => show(step - 1));
  $("[data-restart]").addEventListener("click", () => {
    root.querySelectorAll<HTMLInputElement>("input:checked").forEach((input) => (input.checked = false));
    show(0);
    root.scrollIntoView({ block: "start" });
  });
  show(0);
</script>

<style>
  .quiz { max-width: 820px; margin: 0 auto; display: grid; gap: 1.25rem; padding: clamp(1.25rem, 3vw, 2.25rem); }
  .progress { display: grid; gap: 0.6rem; }
  .progress-label { margin: 0; font-size: 0.8rem; font-weight: 650; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
  .bars { display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; gap: 0.4rem; }
  .bars span { height: 4px; border-radius: 4px; background: var(--line); position: relative; overflow: hidden; }
  .bars span::after { content: ""; position: absolute; inset: 0; background: var(--brand); transform: scaleX(0); transform-origin: left; transition: transform 400ms var(--ease); }
  .bars span.on::after { transform: scaleX(1); }
  fieldset { border: 0; margin: 0; padding: 0; animation: rise 380ms var(--ease) both; }
  legend { padding: 0; font-family: var(--font-display); font-weight: 700; font-size: clamp(1.35rem, 2.6vw, 1.75rem); letter-spacing: -0.01em; margin-bottom: 1.1rem; }
  .answers { display: grid; gap: 0.6rem; }
  .answer {
    display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 0.85rem; padding: 0.95rem 1.1rem;
    border: 1px solid var(--line); border-radius: 12px; cursor: pointer; font-weight: 550;
    transition: border-color 150ms, background-color 150ms, transform 150ms var(--ease);
  }
  .answer:hover { border-color: var(--brand-line); transform: translateX(2px); }
  .answer:has(input:checked) { border-color: var(--primary); background: var(--soft); }
  .answer:has(input:focus-visible) { outline: 2px solid var(--primary); outline-offset: 2px; }
  .answer input { width: 20px; height: 20px; accent-color: var(--primary); margin: 0; }
  .answer :global(svg) { width: 17px; height: 17px; color: var(--muted); transition: transform 150ms var(--ease), color 150ms; }
  .answer:hover :global(svg) { color: var(--primary); transform: translateX(2px); }
  .controls:has([hidden]) { display: none; }
  .result { animation: rise 500ms var(--ease) both; scroll-margin-top: 96px; }
  .result h2 { margin: 0.2rem 0 0.5rem; font-size: clamp(1.6rem, 3vw, 2.2rem); }
  .result h3 { margin: 1.5rem 0 0.7rem; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.07em; color: var(--muted); }
  .next { margin-top: 1.75rem; padding-top: 1.5rem; border-top: 1px solid var(--line); display: grid; gap: 1rem; }
  .next p { margin: 0.25rem 0 0; }
  .next-actions { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .also { margin: 1.25rem 0; }
  .also span { font-weight: 600; color: var(--ink-2); }
</style>

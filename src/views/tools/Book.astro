---
// Book a 30-minute intro call. With a booking link set in src/site.ts the visitor picks a free slot
// there; the request form below always works too and reaches the team through src/lib/leads.ts.
// "?for=prototype" preselects the free first working version, the entry point of that offer.
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import type { Lang } from "../../i18n";
import { services, site } from "../../site";

interface Props { lang: Lang }
const { lang } = Astro.props;
const copy = {
  es: {
    title: "Agendar una llamada", description: "Reserve 30 minutos con The Meowpany para hablar de su proyecto, sin ir y venir de correos.",
    lead: "Una videollamada de 30 minutos para entender qué quiere resolver. Si busca la primera versión funcional gratis, en esta llamada acordamos qué va a incluir.",
    pick: "Elegir un horario libre", pickText: "Vea los horarios disponibles en su zona horaria y reserve en un paso. Recibe la invitación para su calendario.",
    or: "¿Prefiere que lo contactemos nosotros?",
    reason: "Motivo", reasons: { prototype: "Quiero ver mi App o Software funcionando antes de pagar", quote: "Quiero un presupuesto", other: "Otra consulta" },
    name: "Nombre", company: "Empresa (opcional)", email: "Correo", phone: "Teléfono o WhatsApp (opcional)",
    topic: "Cuéntenos su idea en pocas líneas", when: "¿Cuándo le queda bien? (opcional)", whenHint: "Por ejemplo: martes o jueves de tarde",
    submit: "Pedir la llamada", sending: "Enviando...", required: "Complete su nombre y un correo válido.",
    sent: "Listo. Le escribimos en menos de un día hábil para confirmar el horario.",
    drafted: "Abrimos su correo con el pedido ya escrito: solo tiene que enviarlo. Si no se abrió, escríbanos a",
  },
  en: {
    title: "Book a call", description: "Book 30 minutes with The Meowpany to talk about your project, without the email back-and-forth.",
    lead: "A 30-minute video call to understand what you want to solve. If you are after the free first working version, this is where we agree on what it will include.",
    pick: "Pick a free slot", pickText: "See the available times in your time zone and book in one step. You get a calendar invitation.",
    or: "Would you rather we reach out?",
    reason: "Reason", reasons: { prototype: "I want to see my app or software working before paying", quote: "I want a quote", other: "Something else" },
    name: "Name", company: "Company (optional)", email: "Email", phone: "Phone or WhatsApp (optional)",
    topic: "Tell us your idea in a few lines", when: "When suits you? (optional)", whenHint: "For example: Tuesday or Thursday afternoon",
    submit: "Request the call", sending: "Sending...", required: "Please add your name and a valid email.",
    sent: "Done. We'll write within one business day to confirm the time.",
    drafted: "Your email app opened with the request written out: just send it. If it didn't open, email us at",
  },
}[lang];
---
<Base lang={lang} title={copy.title} description={copy.description}>
  <header class="page-head">
    <div class="wrap">
      <p class="eyebrow">{lang === "es" ? "Llamada de 30 minutos" : "30-minute call"}</p>
      <h1>{copy.title}</h1>
      <p class="lead">{copy.lead}</p>
    </div>
  </header>
  <section class="section">
    <div class="wrap narrow">

      {services.bookingUrl && (
        <div class="card pick">
          <h2>{copy.pick}</h2>
          <p>{copy.pickText}</p>
          <p><a class="btn btn-accent" href={services.bookingUrl} target="_blank" rel="noopener">{copy.pick}<Icon name="arrow-up-right" /></a></p>
        </div>
      )}

      {services.bookingUrl && <h2 class="or">{copy.or}</h2>}
      <form id="book-form" class="card" novalidate data-lang={lang} data-email={site.email} data-inbox={services.web3formsKey}
        data-text={JSON.stringify(copy)}>
        <p><label>{copy.reason}<br />
          <select name="reason">{Object.entries(copy.reasons).map(([value, label]) => <option value={value}>{label}</option>)}</select></label></p>
        <p><label>{copy.name}<br /><input name="name" autocomplete="name" required maxlength="200" /></label></p>
        <p><label>{copy.company}<br /><input name="company" autocomplete="organization" maxlength="200" /></label></p>
        <p><label>{copy.email}<br /><input name="email" type="email" autocomplete="email" required maxlength="254" /></label></p>
        <p><label>{copy.phone}<br /><input name="phone" type="tel" autocomplete="tel" maxlength="40" /></label></p>
        <p><label>{copy.topic}<br /><textarea name="message" rows="4" maxlength="4000"></textarea></label></p>
        <p><label>{copy.when}<br /><input name="when" maxlength="200" placeholder={copy.whenHint} /></label></p>
        <p hidden><label>Website<input name="website" tabindex="-1" autocomplete="off" /></label></p>
        <p><button class="btn btn-accent" type="submit">{copy.submit}</button></p>
        <p role="status" aria-live="polite" data-status></p>
      </form>
    </div>
  </section>
</Base>

<script>
  import { isBot, isEmail, leadSink } from "../../lib/leads";

  const form = document.getElementById("book-form") as HTMLFormElement;
  const text = JSON.parse(form.dataset.text!);
  const status = form.querySelector<HTMLElement>("[data-status]")!;
  const button = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
  const reason = form.querySelector<HTMLSelectElement>("select[name=reason]")!;

  const preset = new URLSearchParams(location.search).get("for");
  if (preset && [...reason.options].some((o) => o.value === preset)) reason.value = preset;

  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (isBot(form)) return;
    const data = new FormData(form);
    const value = (name: string) => String(data.get(name) ?? "").trim();
    if (!value("name") || !isEmail(value("email"))) {
      status.textContent = text.required;
      return;
    }
    button.disabled = true;
    status.textContent = text.sending;
    const delivery = await leadSink({ web3formsKey: form.dataset.inbox ?? "", email: form.dataset.email ?? "" }).send({
      kind: reason.value === "prototype" ? "prototype" : "call",
      language: form.dataset.lang ?? "es", name: value("name"), email: value("email"), company: value("company"),
      phone: value("phone"), message: value("message"),
      details: { Reason: reason.value, "Preferred time": value("when"), "Time zone": Intl.DateTimeFormat().resolvedOptions().timeZone },
    });
    button.disabled = false;
    if (delivery === "sent") {
      form.querySelectorAll("p:not([data-status])").forEach((p) => p.setAttribute("hidden", ""));
      status.textContent = text.sent;
    } else {
      const link = document.createElement("a");
      link.href = `mailto:${form.dataset.email}`;
      link.textContent = form.dataset.email ?? "";
      status.replaceChildren(`${text.drafted} `, link, ".");
    }
    status.setAttribute("tabindex", "-1");
    status.focus();
  });
</script>

<style>
  .narrow { max-width: 760px; }
  .pick { margin-bottom: 2rem; }
  .pick h2 { margin-top: 0; }
  .or { font-size: 1.3rem; }
  select, input, textarea { width: 100%; }
</style>

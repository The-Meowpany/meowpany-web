---
import Logo from "./Logo.astro";
import { path, type Lang, t } from "../i18n";
import { site, whatsappLink } from "../site";

interface Props { lang: Lang }
const { lang } = Astro.props;
const copy = t(lang);
const year = new Date().getFullYear();
const whatsapp = whatsappLink(copy.whatsappText);
---
<footer class="site-footer">
  <div class="wrap cols">
    <div>
      <Logo />
      <p class="muted">{copy.tagline}<br />{site.city}</p>
    </div>
    <nav aria-label={copy.footer.services}>
      <h2>{copy.footer.services}</h2>
      <ul>
        <li><a href={path("services", lang)}>{copy.nav.services}</a></li>
        <li><a href={path("pricing", lang)}>{copy.nav.pricing}</a></li>
        <li><a href={path("hire", lang)}>{copy.nav.hire}</a></li>
        <li><a href={path("quote", lang)}>{copy.quote}</a></li>
      </ul>
    </nav>
    <nav aria-label={copy.footer.tools}>
      <h2>{copy.footer.tools}</h2>
      <ul>
        <li><a href={path("audit", lang)}>{copy.nav.audit}</a></li>
        <li><a href={path("estimate", lang)}>{copy.nav.estimate}</a></li>
        <li><a href={path("roi", lang)}>{copy.nav.roi}</a></li>
        <li><a href={path("book", lang)}>{copy.nav.book}</a></li>
      </ul>
    </nav>
    <nav aria-label={copy.footer.company}>
      <h2>{copy.footer.company}</h2>
      <ul>
        <li><a href={path("about", lang)}>{copy.nav.about}</a></li>
        <li><a href={path("work", lang)}>{copy.nav.work}</a></li>
        <li><a href={path("process", lang)}>{copy.nav.process}</a></li>
        <li><a href={path("resources", lang)}>{copy.nav.resources}</a></li>
      </ul>
    </nav>
    <div>
      <h2>{copy.footer.reach}</h2>
      <ul>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        {whatsapp && <li><a href={whatsapp} rel="noopener">{copy.whatsapp}</a></li>}
        <li><a href={site.linkedin} rel="noopener">LinkedIn</a></li>
        <li><a href={path("contact", lang)}>{copy.nav.contact}</a></li>
      </ul>
    </div>
  </div>
  <div class="wrap legal">
    <p>© {year} The Meowpany. {copy.footer.rights}</p>
    <p><a href={path("privacy", lang)}>{copy.footer.privacy}</a> · <a href={path("terms", lang)}>{copy.footer.terms}</a> · {copy.footer.cookies}</p>
  </div>
</footer>
<style>
  .site-footer { border-top: 1px solid var(--line); background: var(--soft); padding: 3rem 0 1.5rem; margin-top: 0; }
  .cols { display: grid; gap: 2rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); }
  h2 { font-size: 0.95rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); margin-bottom: 0.75rem; }
  ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.35rem; }
  ul a { color: var(--ink); text-decoration: none; display: inline-block; min-height: 32px; }
  ul a:hover { color: var(--primary); text-decoration: underline; }
  .legal { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem; margin-top: 2rem; padding-top: 1rem; border-top: 1px solid var(--line); color: var(--muted); font-size: 0.9rem; }
  .legal p { margin: 0; }
  .legal a { color: var(--muted); }
</style>

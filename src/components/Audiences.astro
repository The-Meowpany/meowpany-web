---
// Who we work for.
import Icon from "./Icon.astro";
import { audiences } from "../content";
import type { Lang } from "../i18n";

interface Props { lang: Lang }
const { lang } = Astro.props;
---
<ul class="audiences">
  {audiences[lang].map((item) => (
    <li class="reveal"><span class="icon"><Icon name={item.icon} /></span><div><h3>{item.name}</h3><p class="muted">{item.text}</p></div></li>
  ))}
</ul>
<style>
  .audiences { list-style: none; padding: 0; margin: 0; display: grid; gap: 1.75rem 2rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); }
  li { display: grid; grid-template-columns: auto 1fr; gap: 0.9rem; align-items: start; }
  .icon { width: 38px; height: 38px; border-radius: 10px; display: grid; place-items: center; background: var(--bg); color: var(--primary); border: 1px solid var(--line); }
  .icon :global(svg) { width: 19px; height: 19px; }
  h3 { margin-bottom: 0.3rem; }
  p { margin: 0; font-size: 0.95rem; }
</style>

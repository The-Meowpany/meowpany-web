---
// The real brand: the hooded cat mark (SVG) and the "The Meowpany™" wordmark, charcoal on light
// backgrounds and light on dark ones. `tone="light"` forces the light wordmark on a dark surface.
import { withBase } from "../lib/url";

interface Props { size?: number; withText?: boolean; tone?: "auto" | "light" }
const { size = 34, withText = true, tone = "auto" } = Astro.props;
// The wordmark artwork is 348 × 44 px; it is shown at half size or less so it stays sharp.
const wordHeight = Math.round(size * 0.56);
---
<span class:list={["logo", `tone-${tone}`]}>
  <img class="mark" src={withBase("/brand/mark.svg")} width={Math.round(size * 1.264)} height={size} alt="" />
  {withText && (
    <span class="word">
      <img class="on-light" src={withBase("/brand/wordmark-dark.png")} height={wordHeight} width={Math.round(wordHeight * 7.91)} alt="The Meowpany" />
      <img class="on-dark" src={withBase("/brand/wordmark-light.png")} height={wordHeight} width={Math.round(wordHeight * 7.91)} alt="" />
    </span>
  )}
</span>
<style>
  .logo { display: inline-flex; align-items: center; gap: 0.6rem; }
  .mark { display: block; }
  .word img { display: block; }
  .on-dark { display: none !important; }
  .tone-light .on-light { display: none !important; }
  .tone-light .on-dark { display: block !important; }
  @media (prefers-color-scheme: dark) {
    .tone-auto .on-light { display: none !important; }
    .tone-auto .on-dark { display: block !important; }
  }
</style>

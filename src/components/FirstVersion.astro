---
// "See it working before you pay": how the free first working version goes, and what it promises.
import Icon from "./Icon.astro";
import { firstVersion } from "../content";
import { path, type Lang, t } from "../i18n";

interface Props { lang: Lang; id?: string }
const { lang, id } = Astro.props;
const copy = {
  es: {
    eyebrow: "Sin anticipo · sin tarjeta · sin compromiso",
    title: `Su primera versión, funcionando en ${firstVersion.hours} horas`,
    lead: "Antes de invertir, prueba su idea hecha software. Si no lo convence, no sigue y no paga.",
    promisesTitle: "Por qué es distinto",
  },
  en: {
    eyebrow: "No deposit · no card · no strings",
    title: `Your first version, working in ${firstVersion.hours} hours`,
    lead: "Before you invest, you try your idea as real software. If it doesn't convince you, you stop and pay nothing.",
    promisesTitle: "Why it's different",
  },
}[lang];
---
<section class="section first-version" id={id}>
  <div class="wrap">
    <p class="chip reveal"><span class="dot" aria-hidden="true"></span>{copy.eyebrow}</p>
    <h2 class="reveal">{copy.title}</h2>
    <p class="lead reveal">{copy.lead}</p>

    <ol class="steps">
      {firstVersion.steps[lang].map((step) => (
        <li class="card reveal">
          <span class="icon"><Icon name={step.icon} /></span>
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </li>
      ))}
    </ol>

    <h3 class="promises-title reveal">{copy.promisesTitle}</h3>
    <ul class="promises">
      {firstVersion.promises[lang].map(([icon, text]) => <li class="reveal"><Icon name={icon} /><span>{text}</span></li>)}
    </ul>

    <p class="actions reveal">
      <a class="btn btn-primary glow" href={`${path("book", lang)}?for=prototype`}>{t(lang).seeItWorking}<Icon name="arrow-right" /></a>
    </p>
  </div>
</section>

<style>
  .first-version { position: relative; overflow: hidden; }
  .first-version::before {
    content: ""; position: absolute; inset: -40% -20% auto auto; width: 60vw; height: 60vw; max-width: 720px; max-height: 720px;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--primary) 14%, transparent), transparent);
    pointer-events: none; z-index: -1;
  }
  .chip {
    display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.35rem 0.9rem; border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--primary) 35%, var(--line)); background: color-mix(in srgb, var(--primary) 8%, var(--bg));
    color: var(--primary); font-weight: 600; font-size: 0.82rem; letter-spacing: 0.06em; text-transform: uppercase;
  }
  .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--primary); box-shadow: 0 0 0 4px color-mix(in srgb, var(--primary) 20%, transparent); }
  .steps { list-style: none; padding: 0; margin: 2rem 0 0; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); counter-reset: none; }
  .steps h3 { font-weight: 700; }
  .steps p { margin: 0; color: var(--muted); }
  .promises-title { margin-top: 2.5rem; font-weight: 700; }
  .promises { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.85rem 1.5rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); }
  .promises li { display: flex; gap: 0.65rem; align-items: flex-start; }
  .promises :global(svg) { width: 22px; height: 22px; color: var(--primary); flex: none; margin-top: 0.15rem; }
  .actions { margin-top: 2.25rem; }
  .glow { box-shadow: 0 10px 30px color-mix(in srgb, var(--primary) 35%, transparent); }
</style>

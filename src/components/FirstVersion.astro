---
// "See it working before you pay": how the free first working version goes, and what it promises.
import Icon from "./Icon.astro";
import { firstVersion } from "../content";
import { path, type Lang, t } from "../i18n";

interface Props { lang: Lang; id?: string }
const { lang, id } = Astro.props;
const copy = {
  es: {
    eyebrow: "Sin anticipo · sin tarjeta · sin compromiso",
    title: `Su primera versión, funcionando en ${firstVersion.hours} horas`,
    lead: "Antes de invertir, prueba su idea convertida en software real. Si no lo convence, no sigue y no paga.",
    promisesTitle: "Por qué es distinto",
    terms: "Una primera versión por cliente y proyecto. Condiciones completas en los términos.",
  },
  en: {
    eyebrow: "No deposit · no card · no strings",
    title: `Your first version, working in ${firstVersion.hours} hours`,
    lead: "Before you invest, try your idea as real software. If it doesn't convince you, you stop and pay nothing.",
    promisesTitle: "Why it's different",
    terms: "One first version per client and project. Full conditions in the terms.",
  },
}[lang];
---
<section class="section first-version" id={id}>
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h2 class="reveal">{copy.title}</h2>
      <p class="lead reveal">{copy.lead}</p>
    </div>

    <ol class="flow">
      {firstVersion.steps[lang].map((step, index) => (
        <li class="card reveal">
          <div class="head"><span class="icon"><Icon name={step.icon} /></span><span class="num">0{index + 1}</span></div>
          <h3>{step.title}</h3>
          <p class="muted">{step.text}</p>
        </li>
      ))}
    </ol>

    <div class="why">
      <h3 class="reveal">{copy.promisesTitle}</h3>
      <ul class="promises">
        {firstVersion.promises[lang].map(([icon, text]) => <li class="reveal"><Icon name={icon} /><span>{text}</span></li>)}
      </ul>
    </div>

    <div class="actions reveal">
      <a class="btn btn-primary" href={`${path("book", lang)}?for=prototype`}>{t(lang).seeItWorking}<Icon name="arrow-right" /></a>
      <a class="btn btn-ghost" href={path("terms", lang)}>{copy.terms}</a>
    </div>
  </div>
</section>

<style>
  .flow { list-style: none; padding: 0; margin: 0; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 290px), 1fr)); }
  .head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.1rem; }
  .icon { width: 40px; height: 40px; border-radius: 11px; display: grid; place-items: center; background: var(--brand-soft); color: var(--primary); border: 1px solid var(--brand-line); }
  .icon :global(svg) { width: 20px; height: 20px; }
  .num { font-size: 0.85rem; font-weight: 650; color: var(--muted); font-variant-numeric: tabular-nums; }
  .flow p { margin: 0; }
  .why { margin-top: 3rem; padding-top: 2.25rem; border-top: 1px solid var(--line); display: grid; grid-template-columns: 0.55fr 1.45fr; gap: 1.5rem 3rem; }
  .why h3 { font-size: 1.25rem; }
  .promises { list-style: none; padding: 0; margin: 0; display: grid; gap: 1rem 2rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); }
  .promises li { display: flex; gap: 0.7rem; align-items: flex-start; color: var(--ink-2); }
  .promises :global(svg) { width: 20px; height: 20px; color: var(--primary); flex: none; margin-top: 0.15rem; }
  .actions { margin-top: 2.5rem; }
  @media (max-width: 820px) { .why { grid-template-columns: 1fr; } }
</style>

---
import { money, type Lang, t } from "../i18n";
import { prices } from "../pricing";

interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = t(lang);
const plans = {
  es: [
    { name: "Básico", price: prices.support.basic, items: ["Hosting y certificado de seguridad", "Copia de seguridad semanal", "Actualizaciones de seguridad", "Respuesta en 2 días hábiles"] },
    { name: "Profesional", price: prices.support.pro, items: ["Todo lo del plan Básico", "Copia de seguridad diaria", "2 horas de mejoras por mes", "Respuesta en 1 día hábil"], featured: true },
    { name: "Premium", price: prices.support.premium, items: ["Todo lo del plan Profesional", "Monitoreo cada 5 minutos", "5 horas de mejoras por mes", "Respuesta en 4 horas hábiles"] },
  ],
  en: [
    { name: "Basic", price: prices.support.basic, items: ["Hosting and TLS certificate", "Weekly backup", "Security updates", "Reply within 2 business days"] },
    { name: "Pro", price: prices.support.pro, items: ["Everything in Basic", "Daily backup", "2 improvement hours a month", "Reply within 1 business day"], featured: true },
    { name: "Premium", price: prices.support.premium, items: ["Everything in Pro", "Uptime checks every 5 minutes", "5 improvement hours a month", "Reply within 4 business hours"] },
  ],
}[lang];
---
<div class="grid">
  {plans.map((plan) => (
    <article class:list={["card", "reveal", { featured: plan.featured }]}>
      <h3>{plan.name}</h3>
      <p class="price">{money(plan.price, lang)} <small>{ui.price.perMonth}</small></p>
      <ul>{plan.items.map((item) => <li>{item}</li>)}</ul>
    </article>
  ))}
</div>
<style>
  .featured { border: 2px solid var(--primary); }
  ul { padding-left: 1.1rem; margin: 0; color: var(--muted); }
</style>

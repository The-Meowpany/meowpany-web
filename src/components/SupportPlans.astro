---
// Support plans. Every line is a commitment the team can keep and measure today: response times
// and improvement hours are tracked per ticket in Core.
import { type Lang, t } from "../i18n";
import { launch, offers, supportPlans } from "../pricing";

interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = t(lang);
const copy = {
  es: {
    names: { basic: "Básico", pro: "Profesional", premium: "Premium" },
    tagline: { basic: "Para sitios que cambian poco.", pro: "Para negocios que mejoran su sitio o tienda cada mes.", premium: "Para sistemas de los que depende la operación." },
    response: "Respuesta en",
    hours: (n: number) => (n ? `${n} horas de mejoras por mes` : "Sin horas de mejoras incluidas"),
    common: ["Actualizaciones de seguridad del sitio o sistema y sus dependencias", "Copia de seguridad antes de cada cambio que hacemos", "Registro de cada pedido, con su plazo y las horas usadas"],
    proExtra: "Informe mensual de lo hecho",
    premiumExtra: "Revisión mensual de rendimiento y seguridad",
    recommended: "El más elegido",
    note: `El costo de cada plan depende del sitio o sistema que cubre y va en su propuesta. Las horas que excedan el plan se cotizan antes de usarlas. Sin permanencia mínima. Pagando el año por adelantado, ${offers.annualFreeMonths} meses son sin cargo. Los primeros ${launch.clients} clientes tienen el primer mes gratis. El alojamiento y el dominio se pagan a cada proveedor.`,
  },
  en: {
    names: { basic: "Basic", pro: "Pro", premium: "Premium" },
    tagline: { basic: "For sites that rarely change.", pro: "For businesses that improve their site or store every month.", premium: "For systems the business runs on." },
    response: "Reply within",
    hours: (n: number) => (n ? `${n} improvement hours a month` : "No improvement hours included"),
    common: ["Security updates for the site or system and its dependencies", "A backup before every change we make", "Every request logged, with its deadline and the hours used"],
    proExtra: "Monthly report of the work done",
    premiumExtra: "Monthly performance and security review",
    recommended: "Most chosen",
    note: `The cost of each plan depends on the site or system it covers and is set in your proposal. Hours beyond the plan are quoted before they are used. No minimum term. Pay a year in advance and ${offers.annualFreeMonths} months are free. Our first ${launch.clients} clients get the first month free. Hosting and domain fees are paid to each provider.`,
  },
}[lang];
---
<div class="plans balance">
  {supportPlans.map((plan) => (
    <article class:list={["card", "plan", "reveal", { featured: plan.key === "pro" }]}>
      {plan.key === "pro" && <span class="badge brand ribbon">{copy.recommended}</span>}
      <h3>{copy.names[plan.key]}</h3>
      <p class="muted small">{copy.tagline[plan.key]}</p>
      <ul class="check-list">
        <li><span><strong>{copy.response} {plan.responseHours[lang]}</strong></span></li>
        <li><span>{copy.hours(plan.improvementHours)}</span></li>
        {copy.common.map((item) => <li><span>{item}</span></li>)}
        {plan.key !== "basic" && <li><span>{copy.proExtra}</span></li>}
        {plan.key === "premium" && <li><span>{copy.premiumExtra}</span></li>}
      </ul>
    </article>
  ))}
</div>
<p class="muted small note">{copy.note} {ui.price.vat}.</p>
<style>
  .plans { display: grid; gap: 1rem; align-items: stretch; }
  .plan { display: flex; flex-direction: column; gap: 0.4rem; }
  .plan h3 { margin: 0; }
  .plan .check-list { margin-top: 0.75rem; }
  .featured { border-color: var(--brand-line); box-shadow: 0 0 0 1px var(--brand-line), var(--shadow); }
  .ribbon { position: absolute; top: 1.2rem; right: 1.2rem; }
  .note { margin-top: 1.25rem; max-width: 60rem; }
</style>

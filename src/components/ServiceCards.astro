---
import Icon from "./Icon.astro";
import { services } from "../content";
import { money, type Lang, t } from "../i18n";

interface Props { lang: Lang; detailed?: boolean; only?: string[] }
const { lang, detailed = false, only } = Astro.props;
const copy = t(lang);
const list = services[lang].filter((s) => !only || only.includes(s.key));
const unitLabel = { from: copy.price.from, perMonth: copy.price.perMonth, perHour: copy.price.perHour };
---
<div class="grid services">
  {list.map((s) => (
    <article class="card reveal" id={s.key === "hours" ? "exterior" : s.key}>
      <div class="icon"><Icon name={s.icon} /></div>
      <h3>{s.title}</h3>
      <p class="muted">{s.summary}</p>
      {detailed && (
        <ul class="checks">
          {s.includes.map((item) => <li><Icon name="check" />{item}</li>)}
        </ul>
      )}
      <p class="price">
        {s.unit === "from" && <small>{unitLabel.from} </small>}{money(s.price, lang)}
        {s.unit !== "from" && <small> {unitLabel[s.unit]}</small>}
      </p>
      {detailed && <p class="muted small-time"><Icon name="clock" /> {s.time}</p>}
    </article>
  ))}
</div>
<style>
  .services { grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); }
  .checks { list-style: none; padding: 0; margin: 0 0 1rem; display: grid; gap: 0.4rem; }
  .checks li { display: flex; gap: 0.5rem; align-items: flex-start; }
  .checks :global(svg) { width: 18px; height: 18px; color: var(--primary); flex: none; margin-top: 0.25rem; }
  .small-time { display: flex; align-items: center; gap: 0.4rem; font-size: 0.95rem; margin: 0; }
  .small-time :global(svg) { width: 16px; height: 16px; }
</style>

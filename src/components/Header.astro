---
// Header: four destinations and one action. Everything else lives in the footer, and in the phone
// menu, which has room for it.
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import { alternate, languages, path, type Lang, t } from "../i18n";
import { withoutBase } from "../lib/url";

interface Props { lang: Lang }
const { lang } = Astro.props;
const copy = t(lang);
const current = Astro.url.pathname;
const links = lang === "es"
  ? (["services", "process", "pricing", "news"] as const)
  : (["services", "hire", "pricing", "news"] as const);
// Only in the phone menu.
const extra = (["firstVersion", "offers", "diagnosis", "work", "about", "contact", "quote"] as const);
const isCurrent = (href: string) => withoutBase(current) === withoutBase(href);
const label = (key: string) => (key === "quote" ? copy.quote : copy.nav[key as keyof typeof copy.nav]);
---
<header class="site-header" data-header>
  <div class="wrap bar">
    <a href={path("home", lang)} class="home" aria-label={`The Meowpany · ${copy.tagline}`}><Logo size={30} /></a>
    <button class="toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-open={copy.menu} data-close={copy.close}>
      <span class="bars" aria-hidden="true"></span><span class="toggle-label">{copy.menu}</span>
    </button>
    <nav id="site-nav" class="nav" aria-label={copy.menu}>
      <ul>
        {links.map((key) => {
          const href = path(key, lang);
          return <li><a href={href} aria-current={isCurrent(href) ? "page" : undefined}>{copy.nav[key]}</a></li>;
        })}
        {extra.map((key) => <li class="phone-only"><a href={path(key, lang)}>{label(key)}</a></li>)}
      </ul>
      <div class="end">
        <div class="langs" role="group" aria-label={copy.language}>
          {languages.map((code) => code === lang
            ? <span class="lang on" aria-current="true">{code.toUpperCase()}</span>
            : <a class="lang" href={alternate(current, lang)} hreflang={code} lang={code} aria-label={copy.switchLabel}>{code.toUpperCase()}</a>)}
        </div>
        <button type="button" class="theme" data-theme-toggle data-dark={copy.theme.toDark} data-light={copy.theme.toLight} aria-label={copy.theme.toDark}>
          <span class="sun"><Icon name="sun" /></span><span class="moon"><Icon name="moon" /></span>
        </button>
        <a class="btn btn-primary btn-sm cta" href={`${path("book", lang)}?for=prototype`}>{copy.nav.book}</a>
      </div>
    </nav>
  </div>
</header>

<script>
  // A small menu toggle for phones; on wider screens the navigation is always visible.
  const header = document.querySelector<HTMLElement>("[data-header]");
  const toggle = document.querySelector<HTMLButtonElement>(".toggle");
  const nav = document.getElementById("site-nav");
  toggle?.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") !== "true";
    toggle.setAttribute("aria-expanded", String(open));
    nav?.classList.toggle("open", open);
    document.body.classList.toggle("menu-open", open);
    const label = toggle.querySelector(".toggle-label");
    if (label) label.textContent = open ? toggle.dataset.close ?? "" : toggle.dataset.open ?? "";
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && toggle?.getAttribute("aria-expanded") === "true") toggle.click();
  });
  nav?.addEventListener("click", (event) => {
    if ((event.target as HTMLElement).closest("a") && toggle?.getAttribute("aria-expanded") === "true") toggle.click();
  });
  // Light or dark, remembered on this device. The switch spreads from the button where the browser
  // can animate it; otherwise it simply cross-fades.
  const themeButton = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
  const themeColor = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
  const syncTheme = () => {
    const dark = document.documentElement.dataset.theme === "dark";
    themeButton?.setAttribute("aria-label", (dark ? themeButton.dataset.light : themeButton.dataset.dark) ?? "");
    themeColor?.setAttribute("content", dark ? "#1e1c20" : "#ffffff");
  };
  syncTheme();
  themeButton?.addEventListener("click", () => {
    const root = document.documentElement;
    const next = root.dataset.theme === "dark" ? "light" : "dark";
    const apply = () => {
      root.dataset.theme = next;
      try { localStorage.setItem("theme", next); } catch {}
      syncTheme();
    };
    if (!document.startViewTransition) return apply();
    const { left, top, width, height } = themeButton.getBoundingClientRect();
    const x = left + width / 2;
    const y = top + height / 2;
    const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
    root.classList.add("theming");
    const transition = document.startViewTransition(apply);
    transition.ready.then(() => {
      if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      root.animate({ clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${radius}px at ${x}px ${y}px)`] },
        { duration: 550, easing: "cubic-bezier(0.2, 0.7, 0.2, 1)", pseudoElement: "::view-transition-new(root)" });
    });
    transition.finished.finally(() => root.classList.remove("theming"));
  });
  // Follow the device while the visitor hasn't chosen.
  matchMedia("(prefers-color-scheme: dark)").addEventListener("change", (event) => {
    try { if (localStorage.getItem("theme")) return; } catch {}
    document.documentElement.dataset.theme = event.matches ? "dark" : "light";
    syncTheme();
  });
  // The header gains a shadow once the page scrolls under it.
  const onScroll = () => header?.classList.toggle("scrolled", window.scrollY > 8);
  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();
</script>

<style>
  /* The blur lives on a pseudo-element: on the header itself it would make the header the
     containing block of the fixed mobile menu and clip it. */
  .site-header { position: sticky; top: 0; z-index: 50; border-bottom: 1px solid transparent; transition: border-color 200ms var(--ease), box-shadow 200ms var(--ease); }
  :global(body.menu-open) { overflow: hidden; }
  .site-header::before {
    content: ""; position: absolute; inset: 0; z-index: -1;
    background: color-mix(in srgb, var(--bg) 85%, transparent); backdrop-filter: saturate(180%) blur(14px);
  }
  .site-header.scrolled { border-bottom-color: var(--line); box-shadow: 0 6px 24px -18px rgb(43 40 45 / 35%); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; min-height: 64px; }
  .home { display: inline-flex; text-decoration: none; flex: none; }
  .home :global(.mark) { transition: transform 300ms var(--ease); transform-origin: 50% 80%; }
  .home:hover :global(.mark) { transform: rotate(-8deg) scale(1.06); }
  .nav { display: flex; align-items: center; gap: 1rem; flex: 1; justify-content: space-between; }
  .nav ul { display: flex; gap: 0.25rem; list-style: none; margin: 0 auto; padding: 0; }
  .nav ul a {
    position: relative; display: inline-flex; align-items: center; min-height: 38px; padding: 0 0.85rem;
    color: var(--muted); text-decoration: none; font-size: 0.94rem; font-weight: 550; white-space: nowrap; transition: color 150ms;
  }
  /* A pink underline that grows from the centre on hover and stays on the current page. */
  .nav ul a::after {
    content: ""; position: absolute; left: 0.85rem; right: 0.85rem; bottom: 4px; height: 2px; border-radius: 2px;
    background: var(--brand); transform: scaleX(0); transition: transform 250ms var(--ease);
  }
  .nav ul a:hover { color: var(--ink); }
  .nav ul a:hover::after, .nav ul a[aria-current="page"]::after { transform: scaleX(1); }
  .nav ul a[aria-current="page"] { color: var(--ink); }
  .phone-only { display: none; }
  .end { display: flex; align-items: center; gap: 0.5rem; }
  /* ES | EN: the current language is the highlighted one. */
  .langs { display: inline-flex; padding: 3px; border-radius: 10px; border: 1px solid var(--line); background: var(--soft); }
  .lang { color: var(--muted); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.06em; min-height: 28px; padding: 0 0.55rem; display: inline-flex; align-items: center; text-decoration: none; border-radius: 7px; transition: color 150ms, background-color 150ms; }
  a.lang:hover { color: var(--ink); }
  .lang.on { background: var(--bg); color: var(--ink); box-shadow: var(--shadow-sm); }
  .theme { position: relative; display: grid; place-items: center; width: 38px; height: 38px; border-radius: 10px; border: 1px solid var(--line); background: var(--bg); color: var(--ink-2); cursor: pointer; overflow: hidden; transition: border-color 150ms, color 150ms; }
  .theme:hover { color: var(--primary); border-color: var(--brand-line); }
  .theme span { grid-area: 1 / 1; display: grid; transition: transform 450ms var(--ease), opacity 300ms var(--ease); }
  .theme :global(svg) { width: 18px; height: 18px; }
  .sun { opacity: 0; transform: rotate(-90deg) scale(0.6); }
  :global([data-theme="dark"]) .sun { opacity: 1; transform: none; }
  :global([data-theme="dark"]) .moon { opacity: 0; transform: rotate(90deg) scale(0.6); }
  .toggle {
    display: none; align-items: center; gap: 0.55rem; min-height: 40px; padding: 0 0.9rem; border-radius: 10px;
    border: 1px solid var(--line-strong); background: var(--bg); color: var(--ink); font: inherit; font-size: 0.92rem; font-weight: 600; cursor: pointer;
  }
  .bars, .bars::before, .bars::after { display: block; width: 14px; height: 1.6px; background: currentColor; border-radius: 2px; position: relative; transition: transform 200ms var(--ease), background-color 200ms; }
  .bars::before, .bars::after { content: ""; position: absolute; left: 0; }
  .bars::before { top: -4.5px; }
  .bars::after { top: 4.5px; }
  .toggle[aria-expanded="true"] .bars { background: transparent; }
  .toggle[aria-expanded="true"] .bars::before { transform: translateY(4.5px) rotate(45deg); }
  .toggle[aria-expanded="true"] .bars::after { transform: translateY(-4.5px) rotate(-45deg); }

  @media (max-width: 880px) {
    /* Opaque on phones: blurred page headings ghosting through the bar look like a rendering bug. */
    .site-header::before { background: var(--bg); backdrop-filter: none; }
    .toggle { display: inline-flex; }
    .nav {
      display: none; position: fixed; inset: 64px 0 0 0; background: var(--bg); padding: 1rem 20px calc(2rem + env(safe-area-inset-bottom));
      flex-direction: column; align-items: stretch; justify-content: flex-start; gap: 1.5rem; overflow-y: auto; overscroll-behavior: contain;
    }
    .nav.open { display: flex; animation: menu-in 220ms var(--ease); }
    .nav ul { flex-direction: column; margin: 0; gap: 0; }
    .phone-only { display: block; }
    .nav ul a { display: flex; font-size: 1.15rem; min-height: 54px; color: var(--ink); border-bottom: 1px solid var(--line); padding: 0; }
    .nav ul a::after { display: none; }
    .end { flex-wrap: wrap; justify-content: center; margin-top: auto; }
    .end .btn { flex-basis: 100%; min-height: 50px; font-size: 1rem; }
    .toggle { min-height: 44px; }
    .theme { width: 44px; height: 44px; }
    .lang { min-height: 40px; padding: 0 0.7rem; }
    .langs { padding: 2px; }
  }
  @keyframes menu-in { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: none; } }
</style>

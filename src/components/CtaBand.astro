---
import Icon from "./Icon.astro";
import { path, type Lang, t } from "../i18n";
import { whatsappLink } from "../site";

interface Props { lang: Lang; title: string; text: string }
const { lang, title, text } = Astro.props;
const copy = t(lang);
const whatsapp = whatsappLink(copy.whatsappText);
---
<section class="cta">
  <div class="wrap center reveal">
    <h2>{title}</h2>
    <p class="lead">{text}</p>
    <div class="actions" style="justify-content:center">
      <a class="btn btn-accent" href={path("quote", lang)}>{copy.quote}<Icon name="arrow-right" /></a>
      {whatsapp && <a class="btn btn-ghost on-dark" href={whatsapp} rel="noopener"><Icon name="message-circle" />{copy.whatsapp}</a>}
    </div>
  </div>
</section>
<style>
  .cta { background: #10305a; color: #fff; padding: clamp(3.5rem, 8vw, 6rem) 0; }
  .cta .lead { color: #c9d6e8; }
  .on-dark { color: #fff; border-color: rgb(255 255 255 / 35%); }
</style>

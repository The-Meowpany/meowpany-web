---
// Standards behind each project, and how the company protects information.
import Icon from "./Icon.astro";
import { security, standards } from "../content";
import type { Lang } from "../i18n";

interface Props { lang: Lang; withSecurity?: boolean }
const { lang, withSecurity = true } = Astro.props;
const securityTitle = lang === "es" ? "Seguridad de la información" : "Information security";
---
<div class="standards">
  {standards[lang].map((item) => (
    <article class="card reveal">
      <p class="area">{item.area}</p>
      <h3>{item.name}</h3>
      <p class="muted">{item.text}</p>
    </article>
  ))}
</div>
{withSecurity && (
  <div class="security reveal">
    <div class="head"><span class="icon"><Icon name="shield-check" /></span><h3>{securityTitle}</h3></div>
    <ul class="check-list">{security[lang].map((item) => <li><span>{item}</span></li>)}</ul>
  </div>
)}
<style>
  .standards { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); }
  .area { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--primary); font-weight: 650; margin-bottom: 0.6rem; }
  h3 { font-family: var(--font-display); font-size: 1.2rem; font-weight: 700; }
  .standards p.muted { font-size: 0.95rem; }
  .security { margin-top: 1rem; padding: 1.6rem; border-radius: var(--radius-lg); border: 1px solid var(--line); background: var(--soft); display: grid; grid-template-columns: 0.6fr 1.4fr; gap: 1rem 2rem; }
  .head { display: flex; align-items: center; gap: 0.75rem; }
  .head h3 { margin: 0; }
  .icon { width: 38px; height: 38px; border-radius: 10px; display: grid; place-items: center; background: var(--brand-soft); color: var(--primary); border: 1px solid var(--brand-line); flex: none; }
  .icon :global(svg) { width: 19px; height: 19px; }
  .security .check-list { grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 0.6rem 1.5rem; font-size: 0.95rem; }
  @media (max-width: 760px) { .security { grid-template-columns: 1fr; } }
</style>
